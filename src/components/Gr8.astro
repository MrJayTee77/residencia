---
import Base from '../layouts/Base.astro';
import LangToggle from './LangToggle.astro';
import { localizedPath, type Lang } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;

// Proper names are language-agnostic.
const streamers = ['Alana Flores', 'Juan Guarnizo', 'Rivers GG', 'Ari Gameplays', 'Mercedes Roa'];
const comedy = ['Sofía Niño de Rivera', 'Alex Fernández', 'Daniel Sosa', 'La Cotorrisa', 'Arenovitz', 'Roberto Cein', 'Yael Romero', 'PipePunk', 'Isabel Fernández'];
const partners = ['NataliaMX', 'Aldo Geo', 'Barca Gamer', 'Komanche', 'xlightmoon', 'Crystal Molly', 'Patty Meza', 'Nezumi', 'Caprimint', 'Oscar Amaury', 'Bobicraft', 'Chuy Mine', 'Star VTuber', 'Capitán Gato', 'La Chama', 'Pío FC', 'Aniquiladores', 'Raniza FC', 'Versus', 'SpoilerMX'];

const t = {
  es: {
    title: "GR8 — Agencia de Creadores & Entertainment · By Residencia",
    desc: 'GR8 es la agencia de creadores y entretenimiento de Residencia. No representamos creadores: nos asociamos con ellos.',
    nav: { serv: 'Servicios', tal: 'Talento', ips: "IP's", cta: 'Trabaja con nosotros' },
    eyebrow: 'Agencia de Creadores & Entertainment — By Residencia',
    h: ['No representamos', 'creadores.', ['Nos ', 'asociamos', ' con ellos.']],
    hfoot: 'Solo los creadores forjan conexiones humanas auténticas con la nueva generación de audiencias. Llevamos 18 años ayudando a las marcas a crear su valor digital.',
    btn: 'Trabaja con nosotros →',
    stats: [{ b: '18', l: 'años creando valor digital' }, { b: '50+', l: 'creadores y talentos' }, { b: '5', l: 'categorías de audiencia' }],
    categories: ['Tech', 'Alimentos y Bebidas', 'Lifestyle', 'Moda y Belleza', 'Entretenimiento & Gaming'],
    enfoqueHead: 'El enfoque',
    manifesto: ['No representamos creadores, ', 'los potencializamos.', ' Ayudamos a los creadores más influyentes a capitalizar esa conexión de cada día.'],
    servHead: 'Nuestros servicios',
    pillars: [
      { n: '01', h: 'New Business & Project Development', tag: 'De un creador, hacemos una marca viva.', d: 'Diseñamos y producimos formatos propios de los creadores: producción, desarrollo, conceptualización, estrategia, comercialización y comunicación.', items: ['Eventos', 'Productos', 'Series', 'Experiencias virtuales', 'Collabs'] },
      { n: '02', h: 'Marketing', tag: 'Impulsamos la comunicación de las marcas.', d: 'Posicionamiento de marca con medios e influencers, narrativas creativas y desarrollo de contenidos, entrenamiento de comunicación y negociación estratégica.', items: ['RRPP', 'Influencer Mkt', 'Creadores UGC', 'Convocatoria para eventos'] },
      { n: '03', h: 'Producción', tag: 'Transformamos ideas en experiencias únicas.', d: 'Expertise en Twitch, Kick, YouTube y TikTok Live. Eventos y torneos de esports, brand experiences y producción audiovisual a la medida.', items: ['Esports y streaming', 'Brand experience y eventos', 'Producción audiovisual'] },
      { n: '04', h: 'Management', tag: 'Hacemos a las marcas parte del universo del creador.', d: 'No solo representamos, potencializamos. Creamos estrategias y narrativas auténticas para creadores de Lifestyle, Tech, Sports, casters y cosplayers.', items: ['Desarrollo estratégico', 'Booking', 'Comercialización'] },
    ],
    talHead: 'Talento', rt: { s: 'Streamers', c: 'Comedia', p: 'GR8 Partners' },
    ipsHead: "GR8 IP's",
    ips: [
      { h: 'Casa Rivers', d: 'Sammy nos abre su casa y descubrimos cómo vive sus pasiones: cocina, T-raza con invitados musicales y el caos creativo de Rivart Attack.' },
      { h: 'Sin Ceintido', d: 'El primer Talk Show en Twitch, conducido por Roberto Cein, donde todo puede pasar: confesiones random, retos sin lógica y caos ordenado.' },
      { h: 'Trasnochadas', d: 'Una transmisión semanal con invitados de todos los tipos que disfrutan de la compañía de Rivers GG.' },
      { h: 'Noche de Chicas', d: 'AmaBlitz y sus invitadas convierten la noche en un espacio íntimo, divertido y honesto: amor, wellness, autoestima y uno que otro secreto.' },
      { h: 'Los Juegos del Bebeleche', d: 'Competencia y entretenimiento en vivo con los creadores de GR8 en un formato de show original.' },
    ],
    cEyebrow: 'Hagamos algo grande', cH: '¿Listos para crear?', back: 'Parte de Residencia ↩', city: 'Ciudad de México',
    footTag: 'Agencia de creadores & entertainment — By Residencia.',
  },
  en: {
    title: "GR8 — Creators & Entertainment Agency · By Residencia",
    desc: "GR8 is Residencia's creators and entertainment agency. We don't represent creators — we partner with them.",
    nav: { serv: 'Services', tal: 'Talent', ips: "IP's", cta: 'Work with us' },
    eyebrow: 'Creators & Entertainment Agency — By Residencia',
    h: ["We don't represent", 'creators.', ['We ', 'partner', ' with them.']],
    hfoot: "Only creators forge authentic human connections with the new generation of audiences. For 18 years we've helped brands create their digital value.",
    btn: 'Work with us →',
    stats: [{ b: '18', l: 'years creating digital value' }, { b: '50+', l: 'creators & talent' }, { b: '5', l: 'audience categories' }],
    categories: ['Tech', 'Food & Beverage', 'Lifestyle', 'Fashion & Beauty', 'Entertainment & Gaming'],
    enfoqueHead: 'The approach',
    manifesto: ["We don't represent creators, ", 'we amplify them.', ' We help the most influential creators capitalize on that everyday connection.'],
    servHead: 'Our services',
    pillars: [
      { n: '01', h: 'New Business & Project Development', tag: 'From a creator, we build a living brand.', d: "We design and produce creators' own formats: production, development, concept, strategy, commercialization and communication.", items: ['Events', 'Products', 'Series', 'Virtual experiences', 'Collabs'] },
      { n: '02', h: 'Marketing', tag: 'We power brand communication.', d: 'Brand positioning with media and influencers, creative narratives and content development, communication training and strategic negotiation.', items: ['PR', 'Influencer Mkt', 'UGC Creators', 'Event casting'] },
      { n: '03', h: 'Production', tag: 'We turn ideas into one-of-a-kind experiences.', d: 'Expertise across Twitch, Kick, YouTube and TikTok Live. Esports events and tournaments, brand experiences and custom audiovisual production.', items: ['Esports & streaming', 'Brand experience & events', 'Audiovisual production'] },
      { n: '04', h: 'Management', tag: "We make brands part of the creator's universe.", d: "We don't just represent, we amplify. We craft authentic strategies and narratives for Lifestyle, Tech and Sports creators, casters and cosplayers.", items: ['Strategic development', 'Booking', 'Commercialization'] },
    ],
    talHead: 'Talent', rt: { s: 'Streamers', c: 'Comedy', p: 'GR8 Partners' },
    ipsHead: "GR8 IP's",
    ips: [
      { h: 'Casa Rivers', d: 'Sammy opens his home and we discover how he lives his passions: cooking, the T-raza with musical guests and the creative chaos of Rivart Attack.' },
      { h: 'Sin Ceintido', d: 'The first Talk Show on Twitch, hosted by Roberto Cein, where anything can happen: random confessions, illogical challenges and ordered chaos.' },
      { h: 'Trasnochadas', d: 'A weekly broadcast with guests of all kinds who enjoy the company of Rivers GG.' },
      { h: 'Noche de Chicas', d: 'AmaBlitz and her guests turn the night into an intimate, fun and honest space: love, wellness, self-esteem and the odd secret.' },
      { h: 'Los Juegos del Bebeleche', d: 'Live competition and entertainment with the GR8 creators in an original show format.' },
    ],
    cEyebrow: "Let's make something big", cH: 'Ready to create?', back: 'Part of Residencia ↩', city: 'Mexico City',
    footTag: 'Creators & entertainment agency — By Residencia.',
  },
}[lang];

const L = (route: string) => localizedPath(route, lang);
---
<Base title={t.title} description={t.desc} theme="theme-gr8" lang={lang}>

  <header class="hdr" data-nav>
    <div class="wrap nav">
      <a href={L('gr8')} class="brand" aria-label="GR8 by Residencia">
        <span class="wm">GR8</span>
        <svg class="smile" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="44" fill="none" stroke="currentColor" stroke-width="9"/><circle cx="36" cy="42" r="6.5" fill="currentColor"/><circle cx="64" cy="42" r="6.5" fill="currentColor"/><path d="M32 60 Q50 80 68 60" fill="none" stroke="currentColor" stroke-width="9" stroke-linecap="round"/></svg>
        <span class="by">By Residencia</span>
      </a>
      <nav class="links">
        <a href="#servicios" data-hot>{t.nav.serv}</a>
        <a href="#talento" data-hot>{t.nav.tal}</a>
        <a href="#ips" data-hot>{t.nav.ips}</a>
        <a href={L('')} class="backlink" data-hot>↩ Residencia</a>
        <LangToggle lang={lang} route="gr8" />
        <a href="#contacto" class="cta" data-hot>{t.nav.cta}</a>
      </nav>
    </div>
  </header>

  <section class="hero holo" data-hero>
    <div class="wrap">
      <span class="eyebrow he">{t.eyebrow}</span>
      <h1 class="h1">
        <span class="ln"><span>{t.h[0]}</span></span>
        <span class="ln"><span>{t.h[1]}</span></span>
        <span class="ln"><span>{t.h[2][0]}<span class="serif-i">{t.h[2][1]}</span>{t.h[2][2]}</span></span>
      </h1>
      <div class="hfoot">
        <p>{t.hfoot}</p>
        <a href="#contacto" class="btn" data-hot>{t.btn}</a>
      </div>
    </div>
  </section>

  <div class="wrap stats">
    {t.stats.map((s) => (<div class="reveal"><b>{s.b}</b><span>{s.l}</span></div>))}
  </div>

  <div class="marquee mq" aria-hidden="true">
    <div class="track">{[...t.categories, ...t.categories].map((c) => (<span>{c}<i>✦</i></span>))}</div>
  </div>

  <section id="enfoque" class="wrap">
    <div class="shead reveal"><span class="num">(01)</span><h2>{t.enfoqueHead}</h2></div>
    <p class="manifesto reveal">{t.manifesto[0]}<span class="grad">{t.manifesto[1]}</span><span class="muted">{t.manifesto[2]}</span></p>
  </section>

  <section id="servicios" class="wrap svc">
    <div class="shead reveal"><span class="num">(02)</span><h2>{t.servHead}</h2></div>
    <div class="pillars">
      {t.pillars.map((p) => (
        <div class="pcard reveal">
          <span class="pn">{p.n}</span>
          <h3>{p.h}</h3>
          <p class="ptag">{p.tag}</p>
          <p class="pd">{p.d}</p>
          <div class="pitems">{p.items.map((it) => <span>{it}</span>)}</div>
        </div>
      ))}
    </div>
  </section>

  <section id="talento" class="wrap">
    <div class="shead reveal"><span class="num">(03)</span><h2>{t.talHead}</h2></div>
    <div class="troster reveal"><h3 class="rt">{t.rt.s}</h3><ul class="rlist big">{streamers.map((s) => <li>{s}</li>)}</ul></div>
    <div class="troster reveal"><h3 class="rt">{t.rt.c}</h3><ul class="rlist">{comedy.map((s) => <li>{s}</li>)}</ul></div>
    <div class="troster reveal"><h3 class="rt">{t.rt.p}</h3><ul class="rlist small">{partners.map((s) => <li>{s}</li>)}</ul></div>
  </section>

  <section id="ips" class="wrap">
    <div class="shead reveal"><span class="num">(04)</span><h2>{t.ipsHead}</h2></div>
    <div class="ipgrid">
      {t.ips.map((ip, i) => (
        <div class={`ipcard reveal ip${(i % 5) + 1}`}><h3>{ip.h}</h3><p>{ip.d}</p></div>
      ))}
    </div>
  </section>

  <section id="contacto" class="contact holo">
    <div class="wrap">
      <span class="eyebrow he reveal">{t.cEyebrow}</span>
      <h2 class="reveal">{t.cH}</h2>
      <a href="mailto:cesar.j@residencia.com.mx" class="cmail reveal" data-hot>cesar.j@residencia.com.mx</a>
      <div class="crow reveal">
        <a href="tel:+525532288017" data-hot>+52 55 3228 8017</a>
        <a href={L('')} data-hot>{t.back}</a>
        <span>{t.city}</span>
      </div>
    </div>
  </section>

  <footer class="wrap foot">
    <span class="wm sm">GR8</span>
    <span class="muted">{t.footTag}</span>
    <span class="muted">© 2026 GR8</span>
  </footer>

</Base>

<style>
  .holo{background:linear-gradient(115deg,#FF4DA6,#C13CFF 26%,#7C5CFF 46%,#37E6E0 70%,#B5FF7D 100%);background-size:300% 300%;animation:holo 16s ease infinite;color:#0B0A12}
  @keyframes holo{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
  .grad{background:linear-gradient(110deg,#FF4DA6,#C13CFF 40%,#37E6E0);-webkit-background-clip:text;background-clip:text;color:transparent}

  .brand{display:flex;align-items:center;gap:.45em;position:relative}
  .wm{font-family:var(--display);font-weight:800;font-size:1.45rem;letter-spacing:-.04em}
  .smile{width:1.05em;height:1.05em;color:var(--accent-2);margin-left:-.15em}
  .by{font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);align-self:flex-end;margin-bottom:.25em}
  @media (max-width:560px){ .by{display:none} }

  .hdr{position:fixed;inset:0 0 auto 0;z-index:100;transition:transform .4s,background .4s,border-color .4s;border-bottom:1px solid transparent}
  .hdr.scrolled{background:rgba(11,10,18,.75);backdrop-filter:blur(16px);border-color:var(--line)}
  .hdr.hide{transform:translateY(-110%)}
  .nav{display:flex;align-items:center;justify-content:space-between;height:76px}
  .links{display:flex;gap:1.5rem;align-items:center}
  .links a{font-size:.86rem;color:var(--muted);font-weight:500;transition:color .25s}
  .links a:hover{color:var(--ink)}
  .links a.cta{color:#0B0A12;background:linear-gradient(110deg,#37E6E0,#B5FF7D);padding:.6em 1.25em;border-radius:100px;font-weight:700}
  .links a.cta:hover{filter:brightness(1.06)}
  @media (max-width:980px){ .links a:not(.cta):not(.backlink){display:none} }

  .hero{min-height:100svh;display:flex;flex-direction:column;justify-content:center;padding-top:90px;position:relative}
  .he{color:rgba(11,10,18,.65)}
  .h1{font-family:var(--display);font-weight:800;font-size:clamp(2.6rem,10vw,9.5rem);line-height:.92;letter-spacing:-.045em;margin:1.2rem 0 0}
  .h1 .ln{display:block;overflow:hidden}
  .h1 .ln span{display:block;transform:translateY(110%);transition:transform 1s cubic-bezier(.16,1,.3,1)}
  [data-hero].in .h1 .ln span{transform:none}
  .h1 .ln:nth-child(2) span{transition-delay:.08s}
  .h1 .ln:nth-child(3) span{transition-delay:.16s}
  .h1 .serif-i{font-style:italic}
  .hfoot{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;flex-wrap:wrap;margin-top:clamp(28px,5vh,56px)}
  .hfoot p{max-width:46ch;color:rgba(11,10,18,.72);font-weight:500}
  .btn{display:inline-block;background:#0B0A12;color:#fff;font-weight:700;padding:.95em 1.8em;border-radius:100px;white-space:nowrap;transition:transform .25s}
  .btn:hover{transform:translateY(-2px)}

  .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;padding-block:clamp(56px,8vh,110px)}
  .stats b{font-family:var(--display);font-weight:800;font-size:clamp(2.8rem,8vw,6rem);letter-spacing:-.04em;display:block;line-height:.9;background:linear-gradient(120deg,#FF4DA6,#C13CFF 45%,#37E6E0);-webkit-background-clip:text;background-clip:text;color:transparent}
  .stats span{color:var(--muted);margin-top:.4em;display:block}
  @media (max-width:680px){ .stats{grid-template-columns:1fr;gap:1.8rem} }

  .mq{border-block:1px solid var(--line);padding:18px 0}
  .mq span{font-family:var(--display);font-weight:700;font-size:clamp(1.1rem,2.6vw,1.9rem);letter-spacing:-.02em;display:inline-flex;align-items:center;gap:1.4rem}
  .mq i{color:var(--accent-2)}

  .manifesto{font-family:var(--display);font-weight:700;font-size:clamp(1.8rem,5vw,4.2rem);line-height:1.02;letter-spacing:-.03em;max-width:20ch}
  .manifesto .muted{color:var(--muted);font-weight:600}

  .pillars{display:grid;grid-template-columns:repeat(2,1fr);gap:clamp(16px,2vw,24px)}
  @media (max-width:820px){ .pillars{grid-template-columns:1fr} }
  .pcard{background:var(--bg-2);border:1px solid var(--line);border-radius:22px;padding:clamp(26px,3vw,40px);position:relative;overflow:hidden;transition:transform .4s,border-color .4s}
  .pcard:hover{transform:translateY(-5px);border-color:transparent}
  .pcard::before{content:"";position:absolute;inset:0;padding:1px;border-radius:22px;background:linear-gradient(120deg,#FF4DA6,#C13CFF,#37E6E0);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;opacity:0;transition:opacity .4s}
  .pcard:hover::before{opacity:1}
  .pn{font-family:var(--display);font-weight:800;font-size:.9rem;color:var(--accent-2)}
  .pcard h3{font-family:var(--display);font-weight:800;font-size:clamp(1.4rem,2.6vw,2rem);letter-spacing:-.03em;line-height:1.02;margin:.6em 0 .4em}
  .ptag{font-family:var(--serif);font-style:italic;font-size:1.15rem;color:var(--accent-2);margin-bottom:.7em}
  .pd{color:var(--muted)}
  .pitems{display:flex;flex-wrap:wrap;gap:.5em;margin-top:1.2em}
  .pitems span{font-size:.8rem;border:1px solid var(--line);border-radius:100px;padding:.35em .9em;color:var(--ink)}

  .troster{border-top:1px solid var(--line);padding-block:clamp(28px,4vh,48px)}
  .rt{font-family:var(--display);font-weight:700;font-size:.8rem;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);margin-bottom:1rem}
  .rlist{list-style:none;display:flex;flex-wrap:wrap;gap:.4em 1.4em}
  .rlist li{font-family:var(--display);font-weight:700;letter-spacing:-.02em;font-size:clamp(1.2rem,3vw,2.1rem);transition:color .25s;cursor:default}
  .rlist.big li{font-size:clamp(1.8rem,5vw,3.6rem)}
  .rlist.small li{font-size:clamp(1rem,2vw,1.4rem);color:var(--muted)}
  .rlist li:hover{color:var(--accent)}
  .rlist.small li:hover{color:var(--accent-2)}

  .ipgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(14px,1.8vw,22px)}
  @media (max-width:900px){ .ipgrid{grid-template-columns:1fr 1fr} }
  @media (max-width:600px){ .ipgrid{grid-template-columns:1fr} }
  .ipcard{border-radius:20px;padding:clamp(22px,2.4vw,32px);color:#0B0A12;min-height:230px;display:flex;flex-direction:column;justify-content:flex-end;transition:transform .4s}
  .ipcard:hover{transform:translateY(-5px) scale(1.01)}
  .ipcard h3{font-family:var(--display);font-weight:800;font-size:clamp(1.3rem,2.2vw,1.7rem);letter-spacing:-.03em;margin-bottom:.5em}
  .ipcard p{font-size:.9rem;font-weight:500;opacity:.85}
  .ipcard.ip1{background:linear-gradient(135deg,#FF4DA6,#C13CFF)}
  .ipcard.ip2{background:linear-gradient(135deg,#7C5CFF,#37E6E0)}
  .ipcard.ip3{background:linear-gradient(135deg,#37E6E0,#B5FF7D)}
  .ipcard.ip4{background:linear-gradient(135deg,#FFA84D,#FF4DA6)}
  .ipcard.ip5{background:linear-gradient(135deg,#C13CFF,#FF4DA6)}

  .contact{text-align:center;margin-top:clamp(40px,6vh,90px);padding-block:clamp(70px,11vh,150px)}
  .contact .he{color:rgba(11,10,18,.6)}
  .contact h2{font-family:var(--display);font-weight:800;font-size:clamp(2.6rem,9vw,7rem);letter-spacing:-.045em;line-height:.9;margin:.5rem 0 1.2rem}
  .cmail{display:inline-block;font-family:var(--display);font-weight:700;font-size:clamp(1.2rem,3.4vw,2.4rem);letter-spacing:-.02em;border-bottom:2px solid #0B0A12;padding-bottom:.1em}
  .crow{display:flex;justify-content:center;gap:clamp(1rem,3vw,3rem);margin-top:1.8rem;flex-wrap:wrap;color:rgba(11,10,18,.7);font-weight:500}
  .crow a{border-bottom:1px solid rgba(11,10,18,.4);padding-bottom:.15em}

  .foot{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;padding-block:clamp(40px,6vh,72px);border-top:1px solid var(--line)}
  .foot .wm.sm{font-size:1.3rem}
</style>
