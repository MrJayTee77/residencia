---
import Base from '../../layouts/Base.astro';
import Shell from './Shell.astro';
import { categories, byCategory, igUrl, twUrl, reach, kingsNote, portraits, portraitCount, creators } from '../../data/v4/roster';

const B = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Roster de creadores — GR8 by Residencia" description="El roster de creadores de GR8 by Residencia: top creadores, equipos de Kings League, casters y cosplayers." theme="theme-res-v3" lang="es" og="gr8">
  <div class="v4 u-gr8">
    <Shell active="creadores" unit="gr8" heroDark>

      <section class="rhero invert">
        <span class="mk mk-tl" aria-hidden="true"></span><span class="mk mk-tr" aria-hidden="true"></span>
        <div class="wrap">
          <p class="kicker">/gr8/creadores</p>
          <h1 class="h-xl">Roster de creadores.</h1>
          <p class="lead">Unimos nuestro expertise con el talento de los streamers más potentes de habla hispana.</p>
          <p class="reach"><span class="reach-v">{reach.total}</span><span class="reach-l">de audiencia combinada<span class="pend-chip">Sin validar</span></span></p>
          <p class="pend-note rnote">{reach.note}</p>
        </div>
      </section>

      <section class="wrap">
        <ul class="catnav">
          {categories.map((c) => (
            <li><a href={`#${c.id}`}><b>{byCategory(c.id).length}</b> {c.label}</a></li>
          ))}
        </ul>
      </section>

      {categories.map((c, i) => (
        <section class="wrap" id={c.id}>
          <div class="shead"><span class="n">[ 0{i + 1} ]</span><h2>{c.label}</h2></div>
          <p class="body catblurb">{c.blurb}</p>
          {c.id === 'kings' && <p class="pend-note kn">{kingsNote}</p>}
          <ul class="roster">
            {byCategory(c.id).map((cr) => (
              <li class={portraits[cr.name] ? 'cr has-shot' : 'cr'}>
                {portraits[cr.name] && (
                  <span class="cr-shot"><img src={portraits[cr.name]} alt={`Retrato de ${cr.name}`} loading="lazy" decoding="async" /></span>
                )}
                <span class="cr-n">{cr.name}</span>
                <span class="cr-c">{c.label}{cr.est ? ` · est. ${cr.est}` : ''}</span>
                {(cr.ig || cr.tw) && (
                  <span class="cr-aud">{[cr.ig && `IG ${cr.ig}`, cr.tw && `Twitch ${cr.tw}`].filter(Boolean).join(' · ')}</span>
                )}
                {cr.other && <span class="cr-note">{cr.other}</span>}
                {cr.president && <span class="cr-note">Presidencia: {cr.president}</span>}
                <span class="cr-links">
                  {cr.instagram
                    ? <a href={igUrl(cr.instagram)} target="_blank" rel="noopener noreferrer">IG {cr.instagram}</a>
                    : <span class="none">IG pendiente</span>}
                  {cr.twitch
                    ? <a href={twUrl(cr.twitch)} target="_blank" rel="noopener noreferrer">Twitch</a>
                    : <span class="none">{c.id === 'kings' ? 'Twitch inactivo' : 'Twitch pendiente'}</span>}
                </span>
                {cr.note && <span class="cr-note">{cr.note}</span>}
              </li>
            ))}
          </ul>
        </section>
      ))}

      <section class="wrap">
        <p class="pend-note">
          {portraitCount} de {creators.length} perfiles tienen retrato en el deck — falta la fotografía del resto.
          Handles corregidos por investigación (Caprimint, aldo_geo, nataliamx, PIO FC, Cry → Kick).
          Solo falta el Twitch de HeyBell. Cifras de audiencia sin validar por GR8. Fotografía pendiente.
        </p>
      </section>

      <section class="ucta invert">
        <div class="wrap">
          <h2 class="h-lg">Hagamos algo GR8</h2>
          <a class="btn" href="mailto:hola@residencia.com.mx">Hablemos<i aria-hidden="true">↗</i></a>
        </div>
      </section>
    </Shell>
  </div>
</Base>

<style>
  .rhero{position:relative;padding-top:clamp(140px,20vh,220px);padding-bottom:clamp(50px,8vh,100px)}
  .reach{display:flex;flex-wrap:wrap;align-items:baseline;gap:.7em;margin-top:clamp(26px,4vh,44px)}
  .reach-v{font-family:var(--display);font-weight:700;font-size:clamp(2.6rem,7vw,5rem);letter-spacing:-.045em;line-height:1;color:var(--accent-text)}
  .reach-l{font-family:var(--mono);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
  .rnote{margin-top:clamp(14px,2vh,22px);max-width:74ch}
  .kn{margin-bottom:1.1em}
  .cr-aud{font-family:var(--mono);font-size:.6rem;letter-spacing:.06em;color:var(--accent-text)}
  .catnav{list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:.6rem}
  .catnav a{display:inline-flex;align-items:center;gap:.5em;min-height:44px;padding:0 1.1em;border-radius:99px;
    border:1px solid var(--line-2);background:var(--card);
    font-family:var(--mono);font-size:.7rem;letter-spacing:.06em;transition:border-color .2s,background .2s}
  .catnav a:hover{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 8%,var(--card))}
  .catnav b{font-family:var(--display);font-size:1rem;color:var(--accent-text)}
  .catblurb{margin-bottom:clamp(20px,3vh,32px)}
  .cr-shot{display:block;margin:-1px -1px .8em;border-radius:7px 7px 0 0;overflow:hidden;background:#0A0714}
  .cr-shot img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover;object-position:top center}
  .cr.has-shot{padding-top:0}
  .ucta{padding-block:clamp(70px,12vh,150px)}
  .ucta .btn{margin-top:clamp(24px,3.4vh,40px)}
</style>
