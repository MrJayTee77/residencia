---
import Base from '../../layouts/Base.astro';
import Shell from './Shell.astro';
import {
  units, agencyCopy, produccionCopy, gr8Copy, synergyCopy,
} from '../../data/v4/content';
import type { UnitId } from '../../data/v4/content';
import { casesForUnit } from '../../data/v4/cases';
import { creators, categories } from '../../data/v4/roster';
import { plate, atmosphereNote, gr8Loop } from '../../data/v4/media';

interface Props { unit: UnitId; }
const { unit } = Astro.props;
const u = units[unit];

const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const R = (p = '') => `${B}/v4${p ? `/${p}` : ''}`;
const kases = casesForUnit(unit);

const ogMap: Record<UnitId, 'agency' | 'production' | 'gr8' | 'synergy'> = {
  agency: 'agency', produccion: 'production', gr8: 'gr8', synergy: 'synergy',
};
let n = 0;
const num = () => `[ 0${++n} ]`;
---
<Base title={`${u.name} — Residencia`} description={u.sub} theme="theme-res-v3" lang="es" og={ogMap[unit]}>
  <div class={`v4 u-${unit}`}>
    <Shell active={unit} unit={unit} heroDark>

      <!-- ══════ HERO ══════ -->
      <section class="uhero invert" style={`--plate:url('${plate[unit]}')`}>
        <div class="uhero-bg" aria-hidden="true" data-motion={unit === 'gr8' ? gr8Loop : undefined}></div>
        <span class="mk mk-tl" aria-hidden="true"></span><span class="mk mk-tr" aria-hidden="true"></span>
        <div class="wrap">
          <p class="kicker">/{u.slug} · {u.kicker}</p>
          <h1 class="h-xl uh1">{u.h1}</h1>
          <p class="lead uh-sub">{u.sub}</p>
          <p class="urole"><span class="label">Su papel en el ecosistema</span><span class="urole-v">{u.role}</span></p>
        </div>
        <p class="pend-note uhero-note">{atmosphereNote}</p>
      </section>

      {unit === 'agency' && (
        <>
          <section class="wrap">
            <div class="shead"><span class="n">{num()}</span><h2>{agencyCopy.thinkHead}</h2></div>
            <div class="stack">{agencyCopy.think.map((p) => <p class="body">{p}</p>)}</div>
          </section>

          <section class="wrap model">
            <div class="shead"><span class="n">{num()}</span><h2>{agencyCopy.modelHead}</h2></div>
            <ol class="chain">
              {agencyCopy.chain.map((c, i) => (
                <li><span class="chain-n">0{i + 1}</span><span class="chain-t">{c}</span></li>
              ))}
            </ol>
            <p class="label sat-k">Alimentando tres motores de ejecución</p>
            <ul class="sats">
              {agencyCopy.satellites.map((s) => (
                <li><a class={`sat u-${s.to}`} href={R(units[s.to].slug)}>
                  <span class="sat-t">{s.t}</span><span class="sat-go">{units[s.to].name} ↘</span>
                </a></li>
              ))}
            </ul>
            <p class="pend-note">Diagrama del deck de GR8 (pág. 5) pendiente de reproducir como pieza animada.</p>
          </section>
        </>
      )}

      {unit === 'produccion' && (
        <>
          <section class="wrap">
            <div class="shead"><span class="n">{num()}</span><h2>{produccionCopy.whatHead}</h2></div>
            <div class="stack">{produccionCopy.what.map((p) => <p class="body">{p}</p>)}</div>
            <ol class="spectrum">
              {produccionCopy.spectrum.map((s, i) => (
                <li><span class="sp-n">{String(i + 1).padStart(2, '0')}</span><span class="sp-t">{s}</span></li>
              ))}
            </ol>
            <p class="pend-note">De blockbuster a always-on. Reel de la unidad pendiente.</p>
          </section>
          <section class="wrap">
            <div class="shead"><span class="n">{num()}</span><h2>{produccionCopy.aiHead}</h2></div>
            <p class="body">{produccionCopy.ai}</p>
          </section>
        </>
      )}

      {unit === 'gr8' && (
        <>
          <section class="wrap">
            <div class="shead"><span class="n">{num()}</span><h2>{gr8Copy.momentHead}</h2></div>
            <div class="proof">
              {gr8Copy.proof.map((p) => (
                <article class="proof-card">
                  <p class="proof-big">{p.big}</p>
                  <p class="proof-l">{p.label}</p>
                  <p class="proof-d">{p.detail}</p>
                </article>
              ))}
            </div>
            <p class="pend-note proof-note">{gr8Copy.proofNote}</p>
            <p class="h-md proof-close">{gr8Copy.proofClose}</p>
          </section>

          <section class="wrap">
            <div class="shead"><span class="n">{num()}</span><h2>{gr8Copy.posHead}</h2></div>
            <div class="stack">{gr8Copy.pos.map((p) => <p class="body">{p}</p>)}</div>
            <p class="label shift-k">{gr8Copy.shiftHead}</p>
            <ul class="shift">
              {gr8Copy.shift.map((s) => (
                <li><span class="from">{s.from}</span><span class="arrow">→</span><span class="to">{s.to}</span></li>
              ))}
            </ul>
          </section>

          <section class="wrap">
            <div class="shead"><span class="n">{num()}</span><h2>{gr8Copy.pathsHead}</h2></div>
            <div class="paths">
              {gr8Copy.paths.map((p) => (
                <article class="path">
                  <span class="path-n">{p.n}</span>
                  <h3 class="h-md">{p.t}</h3>
                  <p class="path-lead">{p.lead}</p>
                  <p class="body">{p.body}</p>
                </article>
              ))}
            </div>
          </section>

          <section class="wrap">
            <div class="shead"><span class="n">{num()}</span><h2>{gr8Copy.pairsHead}</h2></div>
            {gr8Copy.pairs.map((p) => (
              <div class="pair">
                <div class="pair-a">{p.bueno} <b>es bueno.</b></div>
                <div class="pair-b">
                  <span>{p.gr8.replace(p.hi, '')}<b>{p.hi}</b> es GR8.</span>
                  <span class="pair-tag">{p.tag}</span>
                </div>
              </div>
            ))}
            <p class="pend-note">
              {gr8Copy.pairPending.bueno} — {gr8Copy.pairPending.tag}
            </p>
          </section>

          <section class="wrap">
            <div class="shead"><span class="n">{num()}</span><h2>Roster de creadores</h2></div>
            <ul class="catrow">
              {categories.map((c) => (
                <li><span class="cat-n">{creators.filter((x) => x.category === c.id).length}</span><span class="cat-l">{c.label}</span></li>
              ))}
            </ul>
            <a class="btn btn-ghost roster-cta" href={R('gr8/creadores')}>Ver el roster completo<i aria-hidden="true">↘</i></a>
          </section>

          <section class="wrap">
            <div class="shead"><span class="n">{num()}</span><h2>{gr8Copy.partnersHead}</h2></div>
            <ul class="chips">{gr8Copy.partners.map((p) => <li>{p}</li>)}</ul>
          </section>
        </>
      )}

      {unit === 'synergy' && (
        <>
          <section class="wrap">
            <div class="shead"><span class="n">{num()}</span><h2>{synergyCopy.methodHead}</h2></div>
            <ol class="method">
              {synergyCopy.method.map((m, i) => (
                <li><span class="me-n">{String(i + 1).padStart(2, '0')}</span>
                  <span class="me-t">{m.t}</span><span class="me-d">{m.d}</span></li>
              ))}
            </ol>
            <p class="h-md method-close">{synergyCopy.methodClose}</p>
            <p class="body phil">{synergyCopy.phil}</p>
          </section>

          <section class="wrap">
            <div class="shead"><span class="n">{num()}</span><h2>{synergyCopy.reflexHead}</h2></div>
            <h3 class="h-lg reflex-t">{synergyCopy.reflexTitle}</h3>
            <p class="body">{synergyCopy.reflexIntro}</p>
            <div class="reflex">
              {synergyCopy.reflex.map((r) => (
                <article class="rx"><span class="rx-t">{r.t}</span><span class="rx-d">{r.d}</span></article>
              ))}
            </div>
            <p class="body rx-modes">{synergyCopy.reflexModes}</p>
            <p class="pend-note">{synergyCopy.reflexNote}</p>
          </section>

          <section class="wrap">
            <div class="shead"><span class="n">{num()}</span><h2>{synergyCopy.capsExtHead}</h2></div>
            <ul class="chips">{synergyCopy.capsExt.map((c) => <li>{c}</li>)}</ul>
          </section>

          <section class="wrap">
            <div class="shead"><span class="n">{num()}</span><h2>{synergyCopy.clientsHead}</h2></div>
            <ul class="chips">{synergyCopy.clients.map((c) => <li>{c}</li>)}</ul>
            <p class="pend-note clients-n">{synergyCopy.clientsNote}</p>
          </section>

          <section class="wrap">
            <div class="open">
              <p class="label">Decisiones abiertas antes de publicar</p>
              <ol>{synergyCopy.openQuestions.map((q) => <li>{q}</li>)}</ol>
            </div>
          </section>
        </>
      )}

      <!-- ══════ SERVICIOS ══════ -->
      <section class="wrap">
        <div class="shead"><span class="n">{num()}</span><h2>Servicios</h2></div>
        <ul class="chips">{u.services.map((s) => <li>{s}</li>)}</ul>
      </section>

      <!-- ══════ CASOS ══════ -->
      {kases.length > 0 && (
        <section class="wrap">
          <div class="shead"><span class="n">{num()}</span><h2>Casos</h2></div>
          <ul class="cases">
            {kases.map((c) => (
              <li>
                <a class="kase" href={R(`trabajo/${c.slug}`)}>
                  <span class="kase-shot">
                    {c.media?.kind === 'image' && <img src={c.media.src} alt="" loading="lazy" decoding="async" />}
                  </span>
                  <span class="kase-b">
                    <span class="kase-brand">{c.brand}</span>
                    <span class="kase-t">{c.title}</span>
                    <span class="kase-d">{c.blurb}</span>
                    <span class="kase-m">Falta: {c.missing}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- ══════ MARCAS ══════ -->
      {u.brands && (
        <section class="wrap">
          <div class="shead"><span class="n">{num()}</span><h2>Marcas</h2></div>
          <ul class="chips">{u.brands.map((b) => <li>{b}</li>)}</ul>
        </section>
      )}

      <!-- ══════ CTA ══════ -->
      <section class="ucta invert">
        <div class="wrap">
          {unit === 'gr8' && <p class="h-md gr8-close">{gr8Copy.closing}</p>}
          <h2 class="h-lg ucta-h">{u.cta}</h2>
          <a class="btn" href="mailto:hola@residencia.com.mx">Hablemos<i aria-hidden="true">↗</i></a>
        </div>
      </section>

    </Shell>
  </div>
</Base>

<script>
  let ran = false;
  const setup = () => {
    if (ran) return;
    const host = document.querySelector<HTMLElement>('[data-motion]');
    if (!host) return;
    ran = true;
    const conn = (navigator as any).connection;
    const ok = !matchMedia('(prefers-reduced-motion:reduce)').matches
      && matchMedia('(min-width:1024px)').matches
      && matchMedia('(hover:hover)').matches
      && !(conn && (conn.saveData || /2g/.test(conn.effectiveType || '')));
    if (!ok) return;
    const io = new IntersectionObserver((es) => {
      for (const e of es) {
        if (!e.isIntersecting) continue;
        io.disconnect();
        const v = document.createElement('video');
        v.src = host.dataset.motion!;
        v.muted = true; v.loop = true; v.playsInline = true; v.preload = 'auto';
        v.setAttribute('aria-hidden', 'true');
        v.addEventListener('canplay', () => { v.classList.add('ready'); v.play().catch(() => {}); }, { once: true });
        host.prepend(v);
      }
    }, { rootMargin: '300px' });
    io.observe(host);
    document.addEventListener('astro:before-swap', () => { ran = false; io.disconnect(); }, { once: true });
  };
  document.addEventListener('astro:page-load', setup);
  setup();
</script>

<style>
  .uhero{position:relative;padding-top:clamp(140px,20vh,220px);padding-bottom:clamp(50px,8vh,110px);overflow:hidden}
  .uhero-bg{position:absolute;inset:0;background-image:var(--plate);background-size:cover;background-position:center;opacity:.5}
  .uhero-bg video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;
    opacity:0;transition:opacity .9s var(--ease-entrance)}
  .uhero-bg video.ready{opacity:1}
  .uhero-bg::after{content:"";position:absolute;inset:0;
    background:linear-gradient(100deg,rgba(23,16,33,.93) 0%,rgba(23,16,33,.84) 46%,rgba(23,16,33,.55) 100%)}
  .uhero > .wrap,.uhero > .mk{position:relative;z-index:2}
  .uhero-note{position:absolute;left:var(--pad);bottom:14px;z-index:2}
  .uh1{max-width:20ch}
  .uh-sub{margin-top:clamp(20px,3vh,34px)}
  .urole{display:grid;gap:.4em;margin-top:clamp(30px,4.5vh,52px);padding-top:clamp(20px,3vh,32px);
    border-top:1px solid var(--line);max-width:56ch}
  .urole-v{font-family:var(--display);font-weight:600;font-size:clamp(1.05rem,2vw,1.4rem);letter-spacing:-.02em}

  .stack{display:grid;gap:1.1rem}

  .chain{list-style:none;padding:0;display:grid;grid-template-columns:1fr;gap:.7rem}
  @media(min-width:760px){.chain{grid-template-columns:repeat(3,1fr)}}
  .chain li{display:grid;gap:.3em;padding:clamp(20px,2vw,30px);border:1px solid var(--line);
    border-radius:8px;background:var(--card);border-top:3px solid var(--accent)}
  .chain-n{font-family:var(--mono);font-size:.64rem;letter-spacing:.12em;color:var(--accent-text)}
  .chain-t{font-family:var(--display);font-weight:700;font-size:1.4rem;letter-spacing:-.02em}
  .sat-k{margin:clamp(26px,4vh,42px) 0 1rem}
  .sats{list-style:none;padding:0;display:grid;grid-template-columns:1fr;gap:.7rem}
  @media(min-width:860px){.sats{grid-template-columns:repeat(3,1fr)}}
  .sat{display:grid;gap:.5em;height:100%;padding:clamp(18px,1.8vw,26px);border:1px solid var(--line);
    border-radius:8px;background:var(--card);transition:border-color .25s,transform .25s}
  .sat:hover{border-color:var(--accent);transform:translateY(-3px)}
  .sat-t{font-size:.98rem;line-height:1.45}
  .sat-go{font-family:var(--mono);font-size:.66rem;letter-spacing:.1em;text-transform:uppercase;color:var(--accent-text)}

  .spectrum{list-style:none;padding:0;margin-top:clamp(26px,4vh,44px);display:grid;
    grid-template-columns:1fr;gap:.5rem}
  @media(min-width:760px){.spectrum{grid-template-columns:repeat(5,1fr)}}
  .spectrum li{display:grid;gap:.3em;padding:1rem;border-radius:8px;background:var(--card);
    border:1px solid var(--line);border-bottom:3px solid var(--accent)}
  .sp-n{font-family:var(--mono);font-size:.6rem;letter-spacing:.12em;color:var(--accent-text)}
  .sp-t{font-family:var(--display);font-weight:600;font-size:.98rem;letter-spacing:-.01em}

  .proof-note{margin-top:1rem}
  .proof-close{margin-top:clamp(24px,3.4vh,40px);max-width:26ch}
  .shift-k{margin:clamp(28px,4vh,46px) 0 .6rem}

  .paths{display:grid;grid-template-columns:1fr;gap:.8rem}
  @media(min-width:860px){.paths{grid-template-columns:repeat(2,1fr)}}
  .path{display:grid;gap:.6em;padding:clamp(22px,2.4vw,34px);border:1px solid var(--line);
    border-radius:8px;background:var(--card);border-top:3px solid var(--accent)}
  .path-n{font-family:var(--mono);font-size:.66rem;letter-spacing:.14em;color:var(--accent-text)}
  .path-lead{font-family:var(--display);font-weight:600;font-size:1.08rem;letter-spacing:-.015em}

  .catrow{list-style:none;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}
  @media(min-width:760px){.catrow{grid-template-columns:repeat(4,1fr)}}
  .catrow li{display:grid;gap:.2em}
  .cat-n{font-family:var(--display);font-weight:700;font-size:clamp(1.8rem,4vw,2.8rem);letter-spacing:-.04em;line-height:1}
  .cat-l{font-family:var(--mono);font-size:.64rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
  .roster-cta{margin-top:clamp(24px,3.4vh,40px)}

  .method{list-style:none;padding:0;display:grid;grid-template-columns:1fr;gap:.7rem}
  @media(min-width:900px){.method{grid-template-columns:repeat(5,1fr)}}
  .method li{display:grid;gap:.35em;padding:clamp(18px,1.8vw,24px);border:1px solid var(--line);
    border-radius:8px;background:var(--card);border-top:3px solid var(--accent)}
  .me-n{font-family:var(--mono);font-size:.6rem;letter-spacing:.12em;color:var(--accent-text)}
  .me-t{font-family:var(--display);font-weight:700;font-size:1.02rem;letter-spacing:-.02em;line-height:1.15}
  .me-d{font-size:.86rem;line-height:1.5;color:var(--muted)}
  .method-close{margin-top:clamp(24px,3.4vh,40px);max-width:32ch}
  .phil{margin-top:clamp(20px,3vh,32px)}

  .reflex-t{margin-bottom:clamp(16px,2.4vh,26px);max-width:22ch}
  .reflex{display:grid;grid-template-columns:1fr;gap:.7rem;margin-top:clamp(20px,3vh,32px)}
  @media(min-width:760px){.reflex{grid-template-columns:repeat(3,1fr)}}
  .rx{display:grid;gap:.4em;padding:clamp(20px,2vw,28px);border:1px solid var(--line);border-radius:8px;
    background:var(--card);border-top:3px solid var(--accent)}
  .rx-t{font-family:var(--display);font-weight:700;font-size:1.5rem;letter-spacing:-.03em}
  .rx-d{font-size:.92rem;line-height:1.55;color:var(--muted)}
  .rx-modes{margin-top:clamp(18px,2.6vh,28px)}
  .clients-n{margin-top:1.1em}
  .open{padding:clamp(20px,2.4vw,32px);border:1px dashed color-mix(in srgb,var(--accent) 55%,transparent);
    border-radius:8px;background:color-mix(in srgb,var(--accent) 6%,transparent)}
  .open ol{margin:1em 0 0;padding-left:1.3em;display:grid;gap:.7em}
  .open li{font-size:.95rem;line-height:1.6;color:var(--ink-2)}

  .lab-note{margin-top:1.1em}
  .ucta{padding-block:clamp(70px,12vh,150px)}
  .gr8-close{max-width:26ch;margin-bottom:clamp(20px,3vh,34px)}
  .ucta-h{max-width:24ch;margin-bottom:clamp(26px,4vh,44px)}
</style>
