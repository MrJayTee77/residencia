---
import Base from '../layouts/Base.astro';
import SiteNav from './SiteNav.astro';
import '../styles/ds/styles.css';
import '../styles/v3-chapters.css';
import { localizedPath, type Lang } from '../i18n/utils';
import { units } from '../data/units-v3';
import { caseBySlug, cases } from '../data/cases';
import { CONTACT_EMAIL } from '../config';

interface Props { slug: string; lang: Lang; }
const { slug, lang } = Astro.props;

const c = caseBySlug(slug)!;
const copy = c[lang];
const unit = units[c.unit][lang];
const L = (route: string) => localizedPath(route, lang);
const more = cases.filter((x) => x.slug !== slug).slice(0, 3);

const t = {
  es: {
    pending: 'Pendiente', caseOf: 'Caso', unitLabel: 'Unidad', year: 'Año',
    challenge: 'El reto', idea: 'La idea', execution: 'La ejecución', result: 'El resultado',
    resultsHead: 'Resultados', pendingData: 'Dato por confirmar',
    moreHead: 'Más casos', backWork: 'Todos los casos',
    ctaHead: '¿Hablamos de tu proyecto?', write: 'Escríbenos',
    subj: `Consulta sobre el caso ${c.brand} — Residencia`,
    draftNote: 'Este caso está en preparación. El texto mostrado es marcador de posición.',
  },
  en: {
    pending: 'Pending', caseOf: 'Case', unitLabel: 'Unit', year: 'Year',
    challenge: 'The challenge', idea: 'The idea', execution: 'The execution', result: 'The result',
    resultsHead: 'Results', pendingData: 'To be confirmed',
    moreHead: 'More cases', backWork: 'All cases',
    ctaHead: 'Shall we talk about your project?', write: 'Write to us',
    subj: `Enquiry about the ${c.brand} case — Residencia`,
    draftNote: 'This case is in preparation. The text shown is placeholder copy.',
  },
}[lang];

const ogFor = c.unit === 'production' ? 'production' : c.unit === 'gr8' ? 'gr8' : c.unit === 'synergy' ? 'synergy' : 'agency';
const skin = `skin-${c.unit}`;
---
<Base title={`${c.brand} — ${copy.title} — Residencia`} description={copy.summary} theme="theme-res-v3" lang={lang} og={ogFor}>
  <SiteNav lang={lang} route={`v3/case/${slug}`} active="work" skin={skin} />

  <main id="main" class={skin}>
    <section class="hero">
      <div class="hero-plate" aria-hidden="true" style={`--plate:url('${c.plate}')`}></div>
      <span class="mk mk-tl" aria-hidden="true"></span><span class="mk mk-tr" aria-hidden="true"></span>
      <div class="wrap">
        <p class="brandline">{c.brand}</p>
        <h1>
          <span class={c.approved ? '' : 'ph'}>{copy.title}</span>
          {!c.approved && <span class="ph-chip">{t.pending}</span>}
        </h1>
        <dl class="facts">
          <div><dt>{t.unitLabel}</dt><dd>{unit.name}</dd></div>
          <div><dt>{t.year}</dt><dd>{c.year}</dd></div>
          <div><dt>{t.caseOf}</dt><dd>{c.brand}</dd></div>
        </dl>
      </div>
    </section>

    {c.media && (
      <section class="wrap showcase">
        <figure class="show">
          {c.media.kind === 'video'
            ? <video src={`${c.media.src}#t=${c.media.at}`} preload="metadata" controls playsinline aria-label={copy.title}></video>
            : <img src={c.media.src} alt={copy.title} loading="lazy" decoding="async" />}
        </figure>
      </section>
    )}

    <section class="wrap body">
      {!c.approved && <p class="draft ph-note">{t.draftNote}</p>}
      {[
        { h: t.challenge, b: copy.challenge },
        { h: t.idea, b: copy.idea },
        { h: t.execution, b: copy.execution },
        { h: t.result, b: copy.result },
      ].map((blk, i) => (
        <div class="blk reveal">
          <div class="shead"><span class="num">[ 0{i + 1} ]</span><h2>{blk.h}</h2></div>
          <p class={c.approved ? 'para' : 'para ph'}>{blk.b}</p>
        </div>
      ))}
    </section>

    <section class="wrap results">
      <div class="shead reveal"><span class="num">[ 05 ]</span><h2>{t.resultsHead}</h2></div>
      <ul class="metrics">
        {c.metrics.map((mtr) => (
          <li>
            <span class={mtr.value ? 'm-v' : 'm-v empty'}>{mtr.value ?? '—'}</span>
            <span class="m-l">{mtr.label}</span>
          </li>
        ))}
      </ul>
      {!c.metrics.some((mtr) => mtr.value) && <p class="ph-note pend">{t.pendingData}</p>}
    </section>

    <section class="wrap more">
      <div class="shead reveal"><span class="num">[ 06 ]</span><h2>{t.moreHead}</h2></div>
      <ul class="cases">
        {more.map((o) => (
          <li>
            <a class="case-card" href={L(`v3/case/${o.slug}`)} data-hot>
              <span class="case-shot" style={`background-image:url('${o.plate}')`}></span>
              <span class="case-meta">
                <span class="case-brand">{o.brand}</span>
                <span class={o.approved ? 'case-title' : 'case-title ph'}>{o[lang].title}</span>
                <span class="case-unit">{units[o.unit][lang].short}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <a class="backlink2" href={L('v3/work')} data-hot>{t.backWork} ↘</a>
    </section>

    <section id="contact" class="wrap cta">
      <h2 class="cta-h reveal">{t.ctaHead}</h2>
      <a class="cta-btn reveal" href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(t.subj)}`} data-hot>
        {t.write}<i aria-hidden="true">↘</i>
      </a>
    </section>
  </main>

  <footer class={`wrap foot ${skin}`}>
    <a href={L('v3')} class="brand" data-hot><span>Residencia</span></a>
    <span class="muted mono-s">© 2026 Residencia</span>
  </footer>
</Base>

<style>
  main{position:relative;overflow:hidden}
  main>*{position:relative;z-index:2}
  section[id]{scroll-margin-top:84px}

  .hero{position:relative;padding-top:clamp(120px,17vh,190px);padding-bottom:clamp(40px,6vh,80px);overflow:hidden}
  .hero-plate{position:absolute;inset:0;z-index:0;pointer-events:none;
    background-image:var(--plate);background-size:cover;background-position:center}
  .hero-plate::after{content:"";position:absolute;inset:0;
    background:linear-gradient(100deg,var(--scrim-a) 0%,var(--scrim-a) 46%,var(--scrim-b) 100%)}
  .hero>.wrap,.hero>.mk{position:relative;z-index:2}
  .mk{position:absolute;width:14px;height:14px;opacity:.55}
  .mk-tl{top:88px;left:16px;border-top:1.5px solid var(--ink);border-left:1.5px solid var(--ink)}
  .mk-tr{top:88px;right:16px;border-top:1.5px solid var(--ink);border-right:1.5px solid var(--ink)}
  .brandline{font-family:var(--mono);font-size:.78rem;letter-spacing:.22em;text-transform:uppercase;color:var(--accent-text)}
  h1{font-family:var(--u-font,var(--display));font-weight:var(--u-weight,700);
    font-size:calc(clamp(2.2rem,7vw,5.2rem) * var(--u-scale,1));text-transform:var(--u-case,none);
    letter-spacing:var(--u-track,-.04em);line-height:1.02;margin-top:.3em;max-width:20ch}
  .facts{display:flex;flex-wrap:wrap;gap:1.4rem 2.6rem;margin-top:clamp(26px,4vh,46px);
    padding-top:clamp(18px,2.6vh,30px);border-top:1px solid var(--line)}
  .facts dt{font-family:var(--mono);font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
  .facts dd{font-family:var(--display);font-weight:600;font-size:1rem;margin-top:.25em}

  .showcase{padding-block:clamp(20px,3vh,40px)}
  .show{border:1px solid var(--line);border-radius:var(--radius-lg);overflow:hidden;background:#000}
  .show video,.show img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover}

  .body{padding-block:clamp(40px,7vh,96px);display:grid;gap:clamp(30px,4.5vh,56px);max-width:78rem}
  .draft{padding:.7em .9em;border:1px dashed color-mix(in srgb,var(--accent) 55%,transparent);
    border-radius:var(--radius-md);color:var(--accent-text);justify-self:start}
  .blk{display:grid;grid-template-columns:1fr;gap:.6rem}
  @media (min-width:900px){ .blk{grid-template-columns:14rem 1fr;gap:2.4rem} }
  .shead{display:flex;align-items:baseline;gap:.8rem}
  .shead .num{font-family:var(--mono);color:var(--accent-text);font-size:.72rem;letter-spacing:.06em}
  .shead h2{font-family:var(--mono);font-weight:700;font-size:.76rem;letter-spacing:.12em;text-transform:uppercase}
  .para{font-size:clamp(1.02rem,1.5vw,1.16rem);line-height:1.68;color:var(--ink-2);max-width:62ch}

  .results{padding-block:clamp(30px,5vh,70px)}
  .pend{margin-top:.9em}
  .more{padding-block:clamp(40px,7vh,96px);border-top:1px solid var(--line)}
  .backlink2{display:inline-block;margin-top:clamp(20px,3vh,36px);font-family:var(--mono);font-size:.74rem;
    letter-spacing:.1em;text-transform:uppercase;border-bottom:1px solid var(--line);padding-bottom:.25em}
  .backlink2:hover{color:var(--accent-text);border-color:var(--accent-text)}

  .cta{padding-block:clamp(56px,9vh,130px);border-top:1px solid var(--line)}
  .cta-h{font-family:var(--display);font-weight:700;font-size:clamp(1.8rem,5vw,3.6rem);letter-spacing:-.04em;line-height:1.04}
  .cta-btn{display:inline-flex;align-items:center;gap:.6em;margin-top:clamp(22px,3vh,36px);min-height:52px;padding:0 1.6em;
    border-radius:var(--radius-pill);background:var(--accent);color:var(--noturno-900);
    font-family:var(--mono);font-size:.8rem;letter-spacing:.1em;text-transform:uppercase}
  .cta-btn i{font-style:normal;transition:transform .3s}
  .cta-btn:hover{background:var(--vulcanico-400)}
  .cta-btn:hover i{transform:translate(3px,3px)}

  .foot{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;
    padding-block:clamp(32px,5vh,58px);border-top:1px solid var(--line)}
  .brand{font-family:var(--display);font-weight:700;font-size:1rem}
  .mono-s{font-family:var(--mono);font-size:.74rem}
  .muted{color:var(--muted)}
</style>
