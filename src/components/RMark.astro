---
// Residencia brand mark — "R" inside camera-style corner brackets. Uses currentColor.
interface Props { size?: number; class?: string; }
const { size = 30, class: cls = '' } = Astro.props;
---
<svg class={`rmark ${cls}`} width={size} height={size} viewBox="0 0 40 40" fill="none" aria-hidden="true">
  <path d="M3 13V3h10M27 3h10v10M37 27v10H27M13 37H3V27" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" />
  <text x="20.5" y="28.5" text-anchor="middle" font-family="Archivo, system-ui, sans-serif" font-weight="800" font-size="22" letter-spacing="-0.5" fill="currentColor">R</text>
</svg>
