---
import Base from '../layouts/Base.astro';
import LangToggle from './LangToggle.astro';
import '../styles/ds/styles.css';
import { localizedPath, type Lang } from '../i18n/utils';
import { units, unitOrder } from '../data/units';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const logo = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/ds/residencia-mark-noturno.png`;
const mail = 'cesar.j@residencia.com.mx';
const tel = '+525532288017';
const mailto = (subj: string) => `mailto:${mail}?subject=${encodeURIComponent(subj)}`;
const L = (route: string) => localizedPath(route, lang);

// Each root strand terminates at a unit card directly below it.
const branches = unitOrder.map((id) => ({
  id,
  name: units[id][lang].name,
  short: id === 'gr8' ? 'GR8' : units[id][lang].name.replace(' by Residencia', '').replace('Residencia ', ''),
  kind: units[id][lang].kind,
}));

const t = {
  es: {
    title: 'Residencia — Ecosistema creativo para marcas, creadores y cultura',
    desc: 'Residencia — una sola raíz, cuatro formas de crecer. Agency, Production, GR8 y Synergy.',
    contact: 'Contacto',
    coord: 'Ciudad de México — Ecosistema creativo',
    units4: '4 unidades · una raíz',
    hero: { lead: 'Una sola raíz. Cuatro formas de crecer.', cue: 'Sigue la raíz' },
    eco: {
      sub: 'Las raíces crecen desde el nombre hasta cada unidad. Sigue una y entra.',
      enter: 'Entrar',
      blurbs: {
        agency: 'Estrategia, marca y crecimiento digital.',
        production: 'Producción de contenido para cada pantalla.',
        gr8: 'Estudio de creadores y entretenimiento.',
        synergy: 'Experiencias premium, diseñadas con intención.',
      } as Record<string, string>,
    },
    group: {
      kicker: 'El grupo',
      stmt: ['Empezamos como un estudio y seguimos superando la etiqueta. Hoy somos un ', 'ecosistema', ': cuatro unidades con un oficio propio, una misma raíz y la misma creencia — hacer trabajo que la gente recuerda.'],
      fact: '18 años creando valor digital',
    },
    contactSec: {
      kicker: 'Contacto', head: 'Empecemos.', sub: 'Cuéntanos qué necesitas y te conectamos con la unidad correcta.',
      paths: [
        { label: 'Marcas', desc: 'Estrategia, marca y campañas', subj: 'Consulta de marca — Residencia' },
        { label: 'Creadores', desc: 'Colaboraciones y representación (GR8)', subj: 'Consulta de creadores — GR8' },
        { label: 'Producción', desc: 'Comerciales, branded content y formatos', subj: 'Consulta de producción — Residencia' },
        { label: 'General', desc: 'Cualquier otra conversación', subj: 'Consulta general — Residencia' },
      ],
      city: 'Ciudad de México',
    },
    foot: { tag: 'Ecosistema creativo — marca, producción, creadores y experiencias.', rights: '© 2026 Residencia. Todos los derechos reservados.' },
  },
  en: {
    title: 'Residencia — Creative ecosystem for brands, creators and culture',
    desc: 'Residencia — one root, four ways to grow. Agency, Production, GR8 and Synergy.',
    contact: 'Contact',
    coord: 'Mexico City — Creative ecosystem',
    units4: '4 units · one root',
    hero: { lead: 'One root. Four ways to grow.', cue: 'Follow the root' },
    eco: {
      sub: 'The roots grow from the name down to each unit. Follow one and enter.',
      enter: 'Enter',
      blurbs: {
        agency: 'Strategy, brand and digital growth.',
        production: 'Content production for every screen.',
        gr8: 'Creator and entertainment studio.',
        synergy: 'Premium experiences, designed with intent.',
      } as Record<string, string>,
    },
    group: {
      kicker: 'The group',
      stmt: ['We started as one studio and kept outgrowing the label. Today we are an ', 'ecosystem', ': four units with their own craft, one shared root and the same belief — make work people remember.'],
      fact: '18 years creating digital value',
    },
    contactSec: {
      kicker: 'Contact', head: "Let's begin.", sub: 'Tell us what you need and we’ll route you to the right unit.',
      paths: [
        { label: 'Brand inquiry', desc: 'Strategy, brand and campaigns', subj: 'Brand inquiry — Residencia' },
        { label: 'Creator inquiry', desc: 'Collaborations and representation (GR8)', subj: 'Creator inquiry — GR8' },
        { label: 'Production inquiry', desc: 'Commercials, branded content and formats', subj: 'Production inquiry — Residencia' },
        { label: 'General inquiry', desc: 'Any other conversation', subj: 'General inquiry — Residencia' },
      ],
      city: 'Mexico City',
    },
    foot: { tag: 'Creative ecosystem — brand, production, creators and experiences.', rights: '© 2026 Residencia. All rights reserved.' },
  },
}[lang];
---
<Base title={t.title} description={t.desc} theme="theme-res-ds" lang={lang}>

  <header class="hdr" data-nav>
    <div class="wrap nav">
      <a href="#top" class="brand" aria-label="Residencia"><img src={logo} alt="" class="dsmark" width="30" height="30" /><span>Residencia</span></a>
      <nav class="links">
        {branches.map((b) => <a href={L(`v2/${b.id}`)}>{b.short}</a>)}
        <a href="#contact" class="muted">{t.contact}</a>
        <LangToggle lang={lang} route="v2" />
      </nav>
    </div>
  </header>

  <span id="top"></span>

  <!-- ============ THE LIVING NAME → ROOTS → SECTIONS (one continuous piece) ============ -->
  <section class="tree" id="ecosystem">
    <!-- crop-mark corners (the DS framing device) -->
    <span class="mk mk-tl"></span><span class="mk mk-tr"></span><span class="mk mk-bl"></span><span class="mk mk-br"></span>

    <div class="wrap">
      <div class="word-head">
        <span class="coord">{t.coord}</span>
        <span class="coord coord-r">[ {t.units4} ]</span>
      </div>

      <h1 class="wordmark">Residencia</h1>
      <p class="lead">{t.hero.lead}</p>
      <p class="eco-sub">{t.eco.sub}</p>

      <!-- roots grow from the name straight down into the cards -->
      <div class="rootfield" data-stage>
        <div class="roots-area">
          <svg class="roots" viewBox="0 0 1200 470" preserveAspectRatio="none" aria-hidden="true">
            <!-- secondary thin offshoots -->
            <g class="thin">
              <path class="branch" pathLength="1" style="--bd:.22" d="M330 235 C300 268 262 282 224 300" />
              <path class="branch" pathLength="1" style="--bd:.28" d="M360 300 C342 332 322 350 300 372" />
              <path class="branch" pathLength="1" style="--bd:.24" d="M520 225 C502 262 488 286 470 322" />
              <path class="branch" pathLength="1" style="--bd:.24" d="M700 228 C720 264 736 288 758 326" />
              <path class="branch" pathLength="1" style="--bd:.28" d="M880 240 C906 278 942 300 978 322" />
              <path class="branch" pathLength="1" style="--bd:.30" d="M470 350 C482 384 472 408 456 432" />
              <path class="branch" pathLength="1" style="--bd:.30" d="M735 352 C724 386 736 408 752 432" />
            </g>
            <!-- four primary roots -> four card ports -->
            <path class="branch primary" id="rootp-0" pathLength="1" style="--bd:.04" d="M600 6 C600 110 380 150 300 250 C235 330 175 412 150 466" />
            <path class="branch primary" id="rootp-1" pathLength="1" style="--bd:.10" d="M600 6 C600 110 500 150 472 250 C452 330 450 410 450 466" />
            <path class="branch primary" id="rootp-2" pathLength="1" style="--bd:.16" d="M600 6 C600 110 700 150 728 250 C748 330 750 410 750 466" />
            <path class="branch primary" id="rootp-3" pathLength="1" style="--bd:.22" d="M600 6 C600 110 820 150 900 250 C965 330 1025 412 1050 466" />
            <!-- node dots along the system -->
            <g class="dots">
              <circle cx="600" cy="8" r="5" /><circle cx="224" cy="300" r="3.4" /><circle cx="300" cy="372" r="3.4" />
              <circle cx="470" cy="322" r="3.4" /><circle cx="758" cy="326" r="3.4" /><circle cx="978" cy="322" r="3.4" />
              <circle cx="456" cy="432" r="3.4" /><circle cx="752" cy="432" r="3.4" /><circle cx="600" cy="150" r="3.4" />
            </g>
            <!-- the four terminal nodes (where roots meet cards) -->
            <g class="ports">
              <circle cx="150" cy="466" r="7" /><circle cx="450" cy="466" r="7" />
              <circle cx="750" cy="466" r="7" /><circle cx="1050" cy="466" r="7" />
            </g>
          </svg>
        </div>

        <div class="eco-grid">
          {branches.map((b, i) => (
            <a class="eco-card" data-root={i} href={L(`v2/${b.id}`)} data-hot>
              <span class="ec-port" aria-hidden="true"></span>
              <div class="ec-top"><span class="ec-n">0{i + 1}</span><span class="ec-kind">{b.kind}</span></div>
              <h3>{b.name}</h3>
              <p>{t.eco.blurbs[b.id]}</p>
              <span class="ec-go">{t.eco.enter}<i>↘</i></span>
            </a>
          ))}
        </div>
      </div>

      <a class="cue" href="#group" data-hot><span>{t.hero.cue}</span><i>↓</i></a>
    </div>
  </section>

  <!-- ============ GROUP ============ -->
  <section id="group" class="group wrap">
    <div class="shead reveal"><span class="num">[ 01 ]</span><h2>{t.group.kicker}</h2></div>
    <p class="bigstmt reveal">{t.group.stmt[0]}<span class="serif-i">{t.group.stmt[1]}</span>{t.group.stmt[2]}</p>
    <p class="group-fact reveal">{t.group.fact}</p>
  </section>

  <!-- ============ CONTACT ============ -->
  <section id="contact" class="contact">
    <div class="wrap">
      <div class="shead reveal"><span class="num">[ 02 ]</span><h2>{t.contactSec.kicker}</h2></div>
      <h3 class="contact-big reveal">{t.contactSec.head}</h3>
      <p class="eco-sub reveal">{t.contactSec.sub}</p>
      <div class="paths">
        {t.contactSec.paths.map((p) => (
          <a class="path reveal" href={mailto(p.subj)} data-hot>
            <span class="p-label">{p.label}</span>
            <span class="p-desc">{p.desc}</span>
            <span class="p-go">↘</span>
          </a>
        ))}
      </div>
      <div class="crow reveal">
        <a href={`mailto:${mail}`} data-hot>{mail}</a>
        <a href={`tel:${tel}`} data-hot>+52 55 3228 8017</a>
        <span>{t.contactSec.city}</span>
      </div>
    </div>
  </section>

  <footer class="wrap foot">
    <a href="#top" class="brand" data-hot><img src={logo} alt="" class="dsmark" width="26" height="26" /><span>Residencia</span></a>
    <span class="muted ftag">{t.foot.tag}</span>
    <span class="muted mono-s">{t.foot.rights}</span>
  </footer>

</Base>

<style is:global>
  /* Residencia v2 reskinned to the "Combo 09" design system.
     Map the page's semantic variables onto DS tokens:
     paper backgrounds · Noturno ink · single Vulcanico accent · Space Grotesk / Archivo / Space Mono. */
  .theme-res-ds{
    --bg:var(--paper-100);      /* cool paper app background */
    --bg-2:var(--paper-000);    /* raised surface / card */
    --ink:var(--noturno-900);   /* deep teal-navy ink */
    --muted:var(--noturno-500);
    --line:#CED7DC;             /* DS hairline */
    --accent:var(--vulcanico-500);   /* the single hot accent */
    --accent-ink:var(--noturno-900); /* black-on-orange */
    --display:var(--font-display);   /* Space Grotesk */
    --serif:var(--font-display);
    --body:var(--font-body);         /* Archivo */
    --mono:var(--font-mono);         /* Space Mono */
  }
  .theme-res-ds a:focus-visible{outline:none;box-shadow:var(--shadow-focus);border-radius:var(--radius-sm)}
</style>

<style>
  /* nav */
  .hdr{position:fixed;inset:0 0 auto 0;z-index:100;transition:transform .4s,background .4s,border-color .4s;border-bottom:1px solid transparent}
  .hdr.scrolled{background:color-mix(in srgb, var(--paper-100) 84%, transparent);backdrop-filter:blur(14px);border-color:var(--line)}
  .dsmark{width:1.9em;height:auto;flex:none;object-fit:contain}
  .foot .dsmark{width:1.6em}
  .hdr.hide{transform:translateY(-110%)}
  .nav{display:flex;align-items:center;justify-content:space-between;height:74px}
  .brand{display:flex;align-items:center;gap:.5em;font-family:var(--display);font-weight:800;font-size:1.1rem;letter-spacing:-.02em}
  .brand :global(.rmark){flex:none}
  .links{display:flex;gap:1.5rem;align-items:center}
  .links a{font-family:var(--mono);font-size:.74rem;letter-spacing:.04em;text-transform:uppercase;transition:opacity .25s}
  .links a:hover{opacity:.5}
  .links a.muted{color:var(--muted)}
  @media (max-width:900px){ .links>a:not(.muted){display:none} }

  section[id]{scroll-margin-top:88px}

  /* ---- the tree: name → roots → cards ---- */
  .tree{position:relative;padding-top:clamp(120px,16vh,180px);padding-bottom:clamp(48px,7vh,90px);overflow:hidden}
  /* L-shaped registration / crop marks — the signature framing device */
  .mk{position:absolute;width:15px;height:15px;opacity:.6;pointer-events:none}
  .mk-tl{top:90px;left:18px;border-top:1.5px solid var(--ink);border-left:1.5px solid var(--ink)}
  .mk-tr{top:90px;right:18px;border-top:1.5px solid var(--ink);border-right:1.5px solid var(--ink)}
  .mk-bl{bottom:18px;left:18px;border-bottom:1.5px solid var(--ink);border-left:1.5px solid var(--ink)}
  .mk-br{bottom:18px;right:18px;border-bottom:1.5px solid var(--ink);border-right:1.5px solid var(--ink)}

  .word-head{display:flex;justify-content:space-between;gap:1rem;font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:clamp(20px,3vh,34px)}
  .coord-r{text-align:right}
  @media (max-width:620px){ .coord-r{display:none} }

  .wordmark{font-family:var(--display);font-weight:700;text-align:center;
    font-size:clamp(2.7rem,15.5vw,12.5rem);line-height:.9;letter-spacing:-.045em;color:var(--ink)}
  .lead{text-align:center;font-family:var(--body);font-weight:500;font-size:clamp(1.1rem,2.4vw,1.6rem);line-height:1.4;color:var(--noturno-700);margin-top:.7em}

  .rootfield{margin-top:clamp(8px,1.5vh,20px)}
  .roots-area{position:relative;width:100%;height:clamp(190px,28vh,360px)}
  .roots{position:absolute;inset:0;width:100%;height:100%;display:block}
  .roots .branch{fill:none;stroke:var(--ink);stroke-width:1.4;vector-effect:non-scaling-stroke;
    stroke-dasharray:1;stroke-dashoffset:calc(1 - clamp(0, (var(--p,0) - var(--bd,0)) / .5, 1));}
  .roots .primary{stroke-width:2}
  .roots .thin .branch{stroke-width:1;opacity:.6}
  .roots .dots circle{fill:var(--ink);opacity:calc(clamp(0,(var(--p,0) - .5)/.4,1))}
  /* terminal nodes (roots meeting the cards) glow in the Vulcanico accent */
  .roots .ports circle{fill:var(--accent);opacity:1}
  .roots .primary.lit{stroke:var(--accent);stroke-width:3.4}

  .eco-sub{text-align:center;font-family:var(--mono);font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);max-width:52ch;margin:clamp(10px,1.6vh,18px) auto 0}

  .eco-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(.5rem,1vw,1rem);margin-top:0}
  @media (max-width:860px){ .eco-grid{grid-template-columns:repeat(2,1fr)} }
  @media (max-width:520px){ .eco-grid{grid-template-columns:1fr} }
  .eco-card{position:relative;display:flex;flex-direction:column;gap:.5em;min-height:200px;border-radius:var(--radius-lg);
    padding:clamp(18px,1.6vw,26px);border:1px solid var(--line);background:var(--bg-2);
    transition:background .35s,color .35s,transform .35s,border-color .35s,box-shadow .35s}
  .eco-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-md)}
  .ec-port{position:absolute;left:50%;top:0;width:9px;height:9px;border-radius:50%;background:var(--accent);transform:translate(-50%,-50%)}
  .ec-port::before{content:"";position:absolute;left:50%;bottom:100%;width:1px;height:16px;background:var(--ink);transform:translateX(-50%)}
  .eco-card:hover{background:var(--ink);color:var(--bg)}
  .eco-card:hover .ec-port{background:var(--bg)}
  .ec-top{display:flex;justify-content:space-between;align-items:baseline;gap:.5em;font-family:var(--mono);font-size:.66rem;letter-spacing:.08em;text-transform:uppercase}
  .ec-n{font-weight:700;color:var(--accent)}.ec-kind{color:var(--muted)}
  .eco-card:hover .ec-kind{color:var(--bg)}
  .eco-card h3{font-family:var(--display);font-weight:800;font-size:clamp(1.2rem,1.6vw,1.5rem);letter-spacing:-.02em;line-height:1.02;margin-top:.2em}
  .eco-card p{font-size:.9rem;color:var(--muted);flex:1}
  .eco-card:hover p{color:var(--bg)}
  .ec-go{display:inline-flex;align-items:center;gap:.4em;font-family:var(--mono);font-size:.7rem;letter-spacing:.08em;text-transform:uppercase}
  .ec-go i{font-style:normal;transition:transform .35s}
  .eco-card:hover .ec-go i{transform:translate(3px,3px)}

  .cue{display:flex;flex-direction:column;align-items:center;gap:.4em;margin-top:clamp(36px,6vh,72px);
    font-family:var(--mono);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
  .cue i{font-style:normal;animation:bob 1.8s ease-in-out infinite}
  @keyframes bob{50%{transform:translateY(4px)}}

  /* ---- group ---- */
  .shead{display:flex;align-items:baseline;gap:1rem;margin-bottom:clamp(36px,6vh,72px)}
  .shead .num{font-family:var(--mono);color:var(--accent);font-size:.78rem;letter-spacing:.06em}
  .shead h2{font-family:var(--mono);font-weight:700;font-size:.8rem;letter-spacing:.12em;text-transform:uppercase}
  .group{padding-block:clamp(64px,10vh,150px)}
  .bigstmt{font-family:var(--display);font-weight:400;font-size:clamp(1.6rem,4.2vw,3.4rem);line-height:1.06;letter-spacing:-.025em;max-width:26ch}
  .bigstmt .serif-i{font-style:normal;color:var(--accent)}
  .group-fact{margin-top:clamp(32px,5vh,56px);padding-top:clamp(24px,3vh,40px);border-top:1px solid var(--line);font-family:var(--mono);font-size:.92rem;letter-spacing:.04em}

  /* ---- contact ---- */
  .contact{padding-block:clamp(64px,10vh,150px)}
  .contact-big{font-family:var(--display);font-weight:800;font-size:clamp(3rem,11vw,9rem);letter-spacing:-.04em;line-height:.9;text-transform:uppercase}
  .paths{display:grid;grid-template-columns:repeat(2,1fr);gap:.7rem;margin-top:clamp(40px,6vh,72px)}
  @media (max-width:680px){ .paths{grid-template-columns:1fr} }
  .path{display:grid;grid-template-columns:1fr auto;align-items:center;gap:.4em 1em;padding:clamp(22px,2.4vw,34px);border-radius:var(--radius-lg);border:1px solid var(--line);background:var(--bg-2);transition:background .35s,color .35s,border-color .35s,box-shadow .35s}
  .path:hover{background:var(--ink);color:var(--bg);box-shadow:var(--shadow-md)}
  .path .p-go{color:var(--accent)}
  .path:hover .p-go{color:var(--bg)}
  .p-label{font-family:var(--display);font-weight:800;font-size:1.35rem;letter-spacing:-.02em}
  .p-desc{grid-column:1;color:var(--muted);font-size:.92rem;font-family:var(--mono)}
  .path:hover .p-desc{color:var(--bg)}
  .p-go{grid-row:1 / span 2;grid-column:2;font-size:1.5rem;transition:transform .35s}
  .path:hover .p-go{transform:translate(4px,4px)}
  .crow{display:flex;gap:2rem;margin-top:clamp(36px,5vh,60px);color:var(--muted);flex-wrap:wrap;font-family:var(--mono);font-size:.82rem}
  .crow a{border-bottom:1px solid var(--line);padding-bottom:.2em}
  .crow a:hover{border-color:var(--ink);color:var(--ink)}

  /* ---- footer ---- */
  .foot{display:flex;align-items:center;justify-content:space-between;gap:1rem 2rem;flex-wrap:wrap;padding-block:clamp(40px,6vh,72px);border-top:1px solid var(--line)}
  .foot .brand{font-size:1rem}
  .ftag{max-width:32ch;font-family:var(--mono);font-size:.76rem}
  .mono-s{font-family:var(--mono);font-size:.76rem}

  @media (prefers-reduced-motion:reduce){
    .roots .branch{stroke-dashoffset:0}
    .roots .dots circle,.roots .ports circle{opacity:1}
    .eco-card{opacity:1;transform:none}
  }
</style>

<script>
  // Roots grow as the block scrolls into view; one 0→1 progress var drives drawing + card reveal.
  const stage = document.querySelector('[data-stage]') as HTMLElement | null;
  const reduce = window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  const params = new URLSearchParams(location.search);
  const frozen = params.get('p');
  if (params.get('reveal') === '1') document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in'));

  if (stage && frozen !== null) {
    stage.style.setProperty('--p', String(Math.min(1, Math.max(0, parseFloat(frozen) || 0))));
  } else if (stage && reduce) {
    stage.style.setProperty('--p', '1');
  } else if (stage) {
    let ticking = false;
    const set = () => {
      const r = stage.getBoundingClientRect();
      const vh = window.innerHeight;
      const p = Math.min(1, Math.max(0, (vh * 1.0 - r.top) / (vh * 0.5)));
      stage.style.setProperty('--p', p.toFixed(4));
      ticking = false;
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(set); } };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    set();

    // Hover a card → light up its connected root strand.
    document.querySelectorAll<HTMLElement>('.eco-card').forEach((card) => {
      const root = document.getElementById('rootp-' + card.dataset.root);
      if (!root) return;
      card.addEventListener('mouseenter', () => root.classList.add('lit'));
      card.addEventListener('mouseleave', () => root.classList.remove('lit'));
    });
  }
</script>
