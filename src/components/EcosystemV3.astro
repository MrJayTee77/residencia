---
import Base from '../layouts/Base.astro';
import LangToggle from './LangToggle.astro';
import '../styles/ds/styles.css';
import '../styles/v3-chapters.css';
import { localizedPath, type Lang } from '../i18n/utils';
import { unitList, brand } from '../data/units-v3';
import { clientLogos, unitPlate } from '../data/media-v3';

// The hub shows a taste of each unit; the depth lives on the unit pages.
const stripLogos = ['netflix', 'volkswagen', 'coca-cola', 'mattel', 'xbox', 'ford', 'nike', 'huawei', 'telcel', 'porsche']
  .map((s) => clientLogos.find((l) => l.src.endsWith(`${s}.webp`))!)
  .filter(Boolean);
const stripRest = clientLogos.length - stripLogos.length;

interface Props { lang: Lang; }
const { lang } = Astro.props;

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const logo = `${BASE}/ds/residencia-mark-noturno.png`;
const mail = 'cesar.j@residencia.com.mx';
const tel = '+525532288017';
const mailto = (subj: string) => `mailto:${mail}?subject=${encodeURIComponent(subj)}`;
const L = (route: string) => localizedPath(route, lang);

const list = unitList(lang);
const b = brand[lang];

const t = {
  es: {
    title: 'Residencia — Creative Content Strategy',
    desc: 'Residencia: creatividad, estrategia, producción y tecnología conectadas en un mismo ecosistema. Agency, Producción, GR8 y Synergy.',
    coord: 'Ciudad de México', units: '4 unidades · un ecosistema',
    lead: 'El contenido no es solamente un entregable: es la expresión visible de una estrategia.',
    scroll: 'Desplázate', enter: 'Entrar', menu: 'Menú', contact: 'Contacto', index: 'Índice',
    chapters: 'Capítulos', see: 'Ver la unidad',
    agencyBand: 'Algunas de las marcas',
    andMore: (n: number) => `+${n} más ↘`,
    gr8Roster: 'Roster de creadores',
    manifestoKicker: 'Filosofía', ecoHead: b.ecosystemHead,
    contactKicker: 'Contacto', contactHead: 'Empecemos.',
    contactSub: 'Cuéntanos qué necesitas y te conectamos con la unidad correcta.',
    general: { label: 'Conversación general', desc: 'Cualquier otro tema', subj: 'Consulta general — Residencia' },
    city: 'Ciudad de México, México',
    rights: '© 2026 Residencia. Todos los derechos reservados.',
    footTag: 'Creatividad, estrategia, producción y tecnología en un mismo ecosistema.',
    skip: 'Saltar al contenido',
    creatorAlt: 'Creador del roster de GR8',
  },
  en: {
    title: 'Residencia — Creative Content Strategy',
    desc: 'Residencia: creativity, strategy, production and technology connected in one ecosystem. Agency, Production, GR8 and Synergy.',
    coord: 'Mexico City', units: '4 units · one ecosystem',
    lead: 'Content is not simply a deliverable: it is the visible expression of a strategy.',
    scroll: 'Scroll', enter: 'Enter', menu: 'Menu', contact: 'Contact', index: 'Index',
    chapters: 'Chapters', see: 'See the unit',
    agencyBand: 'Some of the brands',
    andMore: (n: number) => `+${n} more ↘`,
    gr8Roster: 'Creator roster',
    manifestoKicker: 'Philosophy', ecoHead: b.ecosystemHead,
    contactKicker: 'Contact', contactHead: 'Let’s begin.',
    contactSub: 'Tell us what you need and we’ll route you to the right unit.',
    general: { label: 'General conversation', desc: 'Anything else', subj: 'General inquiry — Residencia' },
    city: 'Mexico City, Mexico',
    rights: '© 2026 Residencia. All rights reserved.',
    footTag: 'Creativity, strategy, production and technology in one ecosystem.',
    skip: 'Skip to content',
    creatorAlt: 'Creator from the GR8 roster',
  },
}[lang];

const word = 'Residencia'.split('');
---
<Base title={t.title} description={t.desc} theme="theme-res-v3" lang={lang}>

  <a href="#main" class="skip">{t.skip}</a>

  <header class="hdr" data-nav>
    <div class="wrap nav">
      <a href="#top" class="brand" aria-label="Residencia">
        <img src={logo} alt="" class="mark" width="30" height="30" />
        <span>Residencia</span>
      </a>
      <nav class="links" aria-label={t.index}>
        {list.map((u) => <a href={L(`v3/${u.id}`)}>{u.short}</a>)}
        <a href="#contact" class="muted">{t.contact}</a>
        <LangToggle lang={lang} route="v3" />
      </nav>
      <button class="burger" type="button" data-menu-btn aria-expanded="false" aria-controls="mobile-nav">
        <span class="burger-l" aria-hidden="true"></span>
        <span class="burger-t">{t.menu}</span>
      </button>
    </div>
    <div class="mnav" id="mobile-nav" data-menu hidden>
      <nav aria-label={t.menu}>
        {list.map((u) => (
          <a href={L(`v3/${u.id}`)}>
            <span class="mn-n">{u.n}</span><span class="mn-name">{u.short}</span>
            <span class="mn-kind">{u.kind}</span>
          </a>
        ))}
        <a href="#contact" class="mn-contact"><span class="mn-name">{t.contact}</span></a>
      </nav>
      <div class="mnav-foot"><LangToggle lang={lang} route="v3" /></div>
    </div>
  </header>

  <span id="top"></span>

  <main id="main">

    <!-- ══════════════ 00 · ROOT — scroll draws the ecosystem ══════════════ -->
    <section class="ch ch-root" id="ecosystem" data-tone="light" data-chapter="ecosystem">
      <div class="rootstage" data-rootstage>
        <div class="rootstage-in">
          <div class="backdrop" data-backdrop aria-hidden="true">
            {list.map((u) => (
              <div class="bd" data-bd={u.id} style={`--plate:url('${unitPlate[u.id]}')`}
                   transition:name={`p-${u.id}`}></div>
            ))}
          </div>
          <span class="mk mk-tl" aria-hidden="true"></span><span class="mk mk-tr" aria-hidden="true"></span>
          <span class="mk mk-bl" aria-hidden="true"></span><span class="mk mk-br" aria-hidden="true"></span>

          <div class="wrap">
            <div class="stage-head">
              <span class="coord">[ {t.coord} ]</span>
              <span class="coord coord-r">[ {t.units} ]</span>
            </div>

            <h1 class="wordmark" aria-label="Residencia">
              <span aria-hidden="true">{word.map((c, i) => <span class="wl" style={`--i:${i}`}>{c}</span>)}</span>
            </h1>
            <p class="tagline">{b.tagline}</p>
            <p class="lead">{t.lead}</p>

            <div class="field" data-field>
              <svg class="roots" data-roots viewBox="0 0 1200 400" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <g class="strands">
                  {list.map((_u, i) => <path class="strand" data-strand={i} pathLength="1" style={`--i:${i}`} d="" />)}
                </g>
                <g class="nodes">
                  <circle class="origin" data-origin r="5" cx="600" cy="0" />
                  {list.map((_u, i) => <circle class="port" data-port={i} style={`--i:${i}`} r="6" cx="0" cy="0" />)}
                </g>
              </svg>
              <div class="spine" aria-hidden="true"></div>

              <div class="grid" data-grid>
                {list.map((u, i) => (
                  <a class="unit" data-unit={i} data-id={u.id} style={`--i:${i}`} href={L(`v3/${u.id}`)}
                     data-hot transition:name={`u-${u.id}`}>
                    <span class="u-port" aria-hidden="true"></span>
                    <span class="u-top"><span class="u-n">{u.n}</span><span class="u-kind">{u.kind}</span></span>
                    <span class="u-name">{u.short}</span>
                    <span class="u-blurb">{u.blurb}</span>
                    <span class="u-go">{t.enter}<i aria-hidden="true">↘</i></span>
                  </a>
                ))}
              </div>
            </div>

            <p class="cue"><span>{t.scroll}</span><i aria-hidden="true">↓</i></p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════ PROOF — the client marks, kept on the hub ══════════════ -->
    <section class="proof" id="proof" data-tone="light" data-chapter="proof">
      <div class="wrap">
        <p class="sub-k reveal">{t.agencyBand}</p>
        <div class="strip reveal">
          {stripLogos.map((l) => <img src={l.src} alt={l.name} loading="lazy" decoding="async" />)}
          <a class="strip-more" href={L('v3/agency')} data-hot>{t.andMore(stripRest)}</a>
        </div>
      </div>
    </section>

    <!-- ══════════════ PHILOSOPHY + HOW ══════════════ -->
    <section class="ch ch-phil" id="philosophy" data-tone="light" data-chapter="philosophy">
      <span class="thread" aria-hidden="true"><i></i><b></b></span>
      <div class="wrap">
        <div class="shead reveal"><span class="num">[ 05 ]</span><h2>{t.manifestoKicker}</h2></div>
        <p class="stmt reveal">{b.manifesto[0]}</p>
        <div class="mani">{b.manifesto.slice(1).map((p) => <p class="reveal">{p}</p>)}</div>

        <div class="shead shead-2 reveal"><span class="num">[ 06 ]</span><h2>{t.ecoHead}</h2></div>
        <p class="how-lead reveal">{b.ecosystemLead}</p>
        <ol class="roles">
          {list.map((u) => (
            <li class="role reveal">
              <span class="r-n">{u.n}</span>
              <a class="r-name" href={L(`v3/${u.id}`)} data-hot>{u.name}</a>
              <span class="r-desc">{u.role}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ══════════════ CONTACT ══════════════ -->
    <section class="ch contact" id="contact" data-tone="light" data-chapter="contact">
      <div class="wrap">
        <div class="shead reveal"><span class="num">[ 07 ]</span><h2>{t.contactKicker}</h2></div>
        <h2 class="contact-big reveal">{t.contactHead}</h2>
        <p class="contact-sub reveal">{t.contactSub}</p>
        <div class="paths">
          {list.map((u) => (
            <a class="path reveal" href={mailto(u.mailSubj)} data-hot>
              <span class="p-label">{u.short}</span><span class="p-desc">{u.kind}</span>
              <span class="p-go" aria-hidden="true">↘</span>
            </a>
          ))}
          <a class="path reveal" href={mailto(t.general.subj)} data-hot>
            <span class="p-label">{t.general.label}</span><span class="p-desc">{t.general.desc}</span>
            <span class="p-go" aria-hidden="true">↘</span>
          </a>
        </div>
        <div class="crow reveal">
          <a href={`mailto:${mail}`} data-hot>{mail}</a>
          <a href={`tel:${tel}`} data-hot>+52 55 3228 8017</a>
          <span>{t.city}</span>
        </div>
      </div>
    </section>
  </main>

  <footer class="wrap foot">
    <a href="#top" class="brand" data-hot><img src={logo} alt="" class="mark" width="26" height="26" /><span>Residencia</span></a>
    <span class="muted ftag">{t.footTag}</span>
    <span class="muted mono-s">{t.rights}</span>
  </footer>

</Base>

<style>
  /* ═══════════ skip + header ═══════════ */
  .skip{position:absolute;left:-9999px;top:0;z-index:200;padding:.8em 1.2em;background:var(--ink);color:var(--bg);
    font-family:var(--mono);font-size:.78rem;letter-spacing:.08em;text-transform:uppercase}
  .skip:focus{left:12px;top:12px}

  .hdr{position:fixed;inset:0 0 auto 0;z-index:100;border-bottom:1px solid transparent;
    color:var(--ink);transition:transform .4s var(--ease-standard),background .4s,border-color .4s,color .4s}
  .hdr.scrolled{background:color-mix(in srgb,var(--paper-100) 86%,transparent);backdrop-filter:blur(14px);border-color:var(--line)}
  /* over the dark chapters the bar inverts */
  .hdr.on-dark{color:var(--paper-100)}
  .hdr.on-dark.scrolled{background:color-mix(in srgb,var(--noturno-900) 82%,transparent);border-color:rgba(242,247,249,.16)}
  .hdr.on-dark .mark{filter:invert(1) brightness(1.6)}
  .hdr.hide{transform:translateY(-110%)}
  .hdr.open{transform:none;background:var(--bg);border-color:var(--line);color:var(--ink)}
  .hdr.open .mark{filter:none}
  .nav{display:flex;align-items:center;justify-content:space-between;gap:1rem;height:72px}
  .mark{width:1.9em;height:auto;flex:none;object-fit:contain;transition:filter .4s}
  .brand{display:flex;align-items:center;gap:.5em;font-family:var(--display);font-weight:700;font-size:1.05rem;letter-spacing:-.02em}
  .links{display:flex;gap:1.4rem;align-items:center}
  .links a{font-family:var(--mono);font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;transition:color .2s var(--ease-standard)}
  .links a:hover{color:var(--accent)}
  .links a.muted{opacity:.62}
  .burger{display:none;align-items:center;gap:.55em;min-height:44px;padding:0 .2em;background:none;border:0;color:inherit;cursor:pointer}
  .burger-l{position:relative;display:block;width:22px;height:1.5px;background:currentColor;transition:background .2s}
  .burger-l::before,.burger-l::after{content:"";position:absolute;left:0;width:22px;height:1.5px;background:currentColor;transition:transform .28s var(--ease-standard)}
  .burger-l::before{top:-6px}.burger-l::after{top:6px}
  .burger[aria-expanded="true"] .burger-l{background:transparent}
  .burger[aria-expanded="true"] .burger-l::before{transform:translateY(6px) rotate(45deg)}
  .burger[aria-expanded="true"] .burger-l::after{transform:translateY(-6px) rotate(-45deg)}
  .burger-t{font-family:var(--mono);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase}
  .mnav{border-top:1px solid var(--line);background:var(--bg);color:var(--ink);padding:0 var(--pad) 1.4rem}
  .mnav[hidden]{display:none}
  .mnav nav{display:flex;flex-direction:column}
  .mnav a{display:grid;grid-template-columns:auto 1fr;gap:.1em .9em;align-items:baseline;padding:1rem 0;border-bottom:1px solid var(--line);min-height:44px}
  .mn-n{font-family:var(--mono);font-size:.7rem;color:var(--accent-text);letter-spacing:.06em}
  .mn-name{font-family:var(--display);font-weight:700;font-size:1.3rem;letter-spacing:-.02em}
  .mn-kind{grid-column:2;font-family:var(--mono);font-size:.68rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
  .mnav .mn-contact{grid-template-columns:1fr}
  .mnav-foot{padding-top:1.1rem}
  @media (max-width:900px){ .links{display:none} .burger{display:inline-flex} }

  section[id]{scroll-margin-top:84px}

  /* ═══════════ chapter rail ═══════════ */
  .rail{position:fixed;right:22px;top:50%;transform:translateY(-50%);z-index:90;display:none}
  @media (min-width:1180px){ .rail{display:block} }
  .rail ol{list-style:none;display:flex;flex-direction:column;gap:.85rem}
  .rail a{display:flex;align-items:center;gap:.6em;justify-content:flex-end;
    font-family:var(--mono);font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;
    color:var(--muted);opacity:.55;transition:opacity .25s,color .25s}
  .rail-t{opacity:0;transform:translateX(6px);transition:opacity .25s,transform .25s}
  .rail-d{width:7px;height:7px;border:1px solid currentColor;border-radius:50%;flex:none;transition:background .25s,transform .25s}
  .rail a:hover,.rail a:focus-visible{opacity:1}
  .rail a:hover .rail-t,.rail a:focus-visible .rail-t{opacity:1;transform:none}
  .rail a.on{opacity:1;color:var(--accent-text)}
  .rail a.on .rail-d{background:var(--accent);transform:scale(1.25)}
  .rail a.on .rail-t{opacity:1;transform:none}
  /* rail sits over dark chapters too */
  .rail.on-dark a{color:var(--paper-200)}
  .rail.on-dark a.on{color:var(--vulcanico-400)}
  .rail.on-dark a.on .rail-d{background:var(--vulcanico-400)}

  /* ═══════════ chapter shell ═══════════ */
  .ch{position:relative}
  .ch-head{padding-block:clamp(64px,11vh,150px) clamp(28px,4vh,52px);max-width:none}
  .ch-n{display:block;font-family:var(--mono);font-size:.76rem;letter-spacing:.16em;color:var(--accent-text)}
  .ch-title{font-family:var(--u-font,var(--display));font-weight:var(--u-weight,700);
    font-size:calc(clamp(3rem,12vw,10rem) * var(--u-scale,1));
    text-transform:var(--u-case,none);
    line-height:.86;letter-spacing:var(--u-track,-.05em);margin-top:.12em}
  .ch-kind{margin-top:.9em;font-family:var(--mono);font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
  .ch-lead{margin-top:1.1em;max-width:54ch;font-size:clamp(1.02rem,1.8vw,1.32rem);line-height:1.5;color:var(--ink-2)}
  .ch-go{display:inline-flex;align-items:center;gap:.5em;margin-top:clamp(24px,3.5vh,40px);min-height:44px;
    font-family:var(--mono);font-size:.74rem;letter-spacing:.12em;text-transform:uppercase;
    border-bottom:1px solid currentColor;padding-bottom:.25em;transition:color .25s,gap .25s}
  .ch-go i{font-style:normal;transition:transform .3s var(--ease-standard)}
  .ch-go:hover{color:var(--accent-text)}
  .ch-go:hover i{transform:translate(3px,3px)}

  /* ═══════════ 00 · root ═══════════ */
  .ch-root{background:var(--bg)}
  .rootstage{position:relative}
  .rootstage-in{position:relative;padding-top:clamp(104px,13vh,150px);padding-bottom:clamp(36px,5vh,70px);overflow:hidden}
  .mk{position:absolute;width:14px;height:14px;opacity:.55;pointer-events:none}
  .mk-tl{top:88px;left:16px;border-top:1.5px solid var(--ink);border-left:1.5px solid var(--ink)}
  .mk-tr{top:88px;right:16px;border-top:1.5px solid var(--ink);border-right:1.5px solid var(--ink)}
  .mk-bl{bottom:16px;left:16px;border-bottom:1.5px solid var(--ink);border-left:1.5px solid var(--ink)}
  .mk-br{bottom:16px;right:16px;border-bottom:1.5px solid var(--ink);border-right:1.5px solid var(--ink)}
  .stage-head{display:flex;justify-content:space-between;gap:1rem;margin-bottom:clamp(16px,2.5vh,28px);
    font-family:var(--mono);font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
  .coord-r{text-align:right}
  @media (max-width:620px){ .coord-r{display:none} }
  .wordmark{font-family:var(--display);font-weight:700;text-align:center;color:var(--ink);
    font-size:clamp(2.5rem,14vw,11rem);line-height:.9;letter-spacing:-.045em}
  .wl{display:inline-block;will-change:transform,opacity}
  .tagline{text-align:center;margin-top:.6em;font-family:var(--mono);font-size:.72rem;letter-spacing:.22em;
    text-transform:uppercase;color:var(--accent-text)}
  .lead{text-align:center;max-width:34ch;margin:clamp(12px,1.8vh,20px) auto 0;font-family:var(--body);font-weight:500;
    font-size:clamp(1rem,1.9vw,1.28rem);line-height:1.45;color:var(--ink-2)}

  .field{position:relative;margin-top:clamp(28px,4.5vh,58px);padding-top:clamp(120px,17vh,220px)}
  .roots{position:absolute;inset:0;width:100%;height:100%;display:none;pointer-events:none;overflow:visible}
  .roots .strand{fill:none;stroke:var(--ink);stroke-width:1.6;vector-effect:non-scaling-stroke;
    stroke-dasharray:1;stroke-dashoffset:1;opacity:.85;
    transition:stroke .3s var(--ease-standard),opacity .3s var(--ease-standard),stroke-width .3s var(--ease-standard)}
  .roots .origin,.roots .port{fill:var(--ink);transform-box:fill-box;transform-origin:center;transform:scale(0)}
  .roots .port{fill:var(--accent)}
  .spine{position:absolute;left:50%;top:0;width:1.5px;height:clamp(120px,17vh,220px);background:var(--ink);
    transform:translateX(-50%) scaleY(0);transform-origin:top;transition:transform .7s var(--ease-entrance)}

  .grid{display:grid;grid-template-columns:1fr;gap:clamp(.6rem,1vw,1rem)}
  @media (min-width:620px){ .grid{grid-template-columns:repeat(2,1fr)} }
  @media (min-width:1024px){ .grid{grid-template-columns:repeat(4,1fr)} .roots{display:block} .spine{display:none} }

  .unit{position:relative;display:flex;flex-direction:column;gap:.45em;min-height:200px;
    padding:clamp(16px,1.6vw,24px);border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--bg-2);
    transition:background .3s var(--ease-standard),color .3s var(--ease-standard),transform .3s var(--ease-standard),
      border-color .3s var(--ease-standard),box-shadow .3s var(--ease-standard)}
  .u-port{position:absolute;left:50%;top:0;width:9px;height:9px;border-radius:50%;background:var(--accent);
    transform:translate(-50%,-50%) scale(0);transition:transform .3s var(--ease-entrance)}
  .u-top{display:flex;justify-content:space-between;align-items:baseline;gap:.5em;
    font-family:var(--mono);font-size:.64rem;letter-spacing:.08em;text-transform:uppercase}
  .u-n{font-weight:700;color:var(--accent-text)}
  .u-kind{color:var(--muted);text-align:right;transition:color .3s var(--ease-standard)}
  .u-name{font-family:var(--display);font-weight:700;font-size:clamp(1.4rem,2.2vw,1.9rem);letter-spacing:-.03em;line-height:1;margin-top:.15em}
  .u-blurb{font-size:.9rem;line-height:1.45;color:var(--muted);flex:1;transition:color .3s var(--ease-standard)}
  .u-go{display:inline-flex;align-items:center;gap:.4em;font-family:var(--mono);font-size:.68rem;letter-spacing:.08em;text-transform:uppercase}
  .u-go i{font-style:normal;transition:transform .3s var(--ease-standard)}
  .unit:hover,.unit:focus-visible{background:var(--ink);color:var(--bg);border-color:var(--ink);transform:translateY(-4px);box-shadow:var(--shadow-md)}
  .unit:hover .u-kind,.unit:focus-visible .u-kind,.unit:hover .u-blurb,.unit:focus-visible .u-blurb{color:var(--bg-3)}
  .unit:hover .u-port,.unit:focus-visible .u-port{background:var(--bg)}
  .unit:hover .u-go i,.unit:focus-visible .u-go i{transform:translate(3px,3px)}
  .field.gazing .unit:not(.gazed){opacity:.45}
  .field.gazing .roots .strand:not(.lit){opacity:.2}
  .roots .strand.lit{stroke:var(--accent);stroke-width:3}

  .cue{margin-top:clamp(22px,3.5vh,44px);display:flex;flex-direction:column;align-items:center;gap:.3em;
    font-family:var(--mono);font-size:.66rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
  .cue i{font-style:normal;animation:bob 1.9s ease-in-out infinite}
  @keyframes bob{50%{transform:translateY(4px)}}

  /* ── the intro: plays on arrival ── */
  .rootstage.js .wl{opacity:0;transform:translateY(.3em)}
  .rootstage.js .unit{opacity:0;transform:translateY(14px)}
  .rootstage.go .wl{opacity:1;transform:none;
    transition:opacity .45s var(--ease-entrance) calc(var(--i)*35ms),transform .45s var(--ease-entrance) calc(var(--i)*35ms)}
  .rootstage.go .spine{transform:translateX(-50%) scaleY(1);transition-delay:420ms}
  .rootstage.go .roots .strand{stroke-dashoffset:0;
    transition:stroke-dashoffset .56s var(--ease-entrance) calc(500ms + var(--i)*90ms)}
  .rootstage.go .roots .origin,
  .rootstage.go .roots .port{transform:scale(1);transition:transform .3s var(--ease-entrance) calc(900ms + var(--i)*90ms)}
  .rootstage.go .unit{opacity:1;transform:none;
    transition:opacity .4s var(--ease-entrance) calc(950ms + var(--i)*90ms),transform .4s var(--ease-entrance) calc(950ms + var(--i)*90ms)}
  .rootstage.go .unit .u-port{transform:translate(-50%,-50%) scale(1);transition-delay:calc(950ms + var(--i)*90ms)}


  .proof{padding-block:clamp(40px,6vh,80px);border-top:1px solid var(--line)}
  .proof .strip img{width:104px;height:46px}

  /* ═══════════ backdrop — each unit's world, previewed behind the name ═══════════ */
  .backdrop{position:absolute;inset:0;z-index:0;pointer-events:none}
  .bd{position:absolute;inset:0;background-image:var(--plate);background-size:cover;background-position:center;
    opacity:0;transform:scale(1.07);
    transition:opacity .75s var(--ease-entrance),transform 1.4s var(--ease-entrance)}
  .bd.on{opacity:.55;transform:scale(1)}
  /* scrim paints last, so the paper reading stays intact whatever is behind it */
  .backdrop::after{content:"";position:absolute;inset:0;
    background:linear-gradient(rgba(242,247,249,.90),rgba(242,247,249,.95) 60%,var(--paper-100) 100%)}

  /* ═══════════ philosophy ═══════════ */
  .ch-phil{background:var(--bg);padding-block:clamp(64px,10vh,140px)}
  .shead{display:flex;align-items:baseline;gap:1rem;margin-bottom:clamp(30px,4.5vh,58px)}
  .shead-2{margin-top:clamp(56px,9vh,120px)}
  .shead .num{font-family:var(--mono);color:var(--accent-text);font-size:.76rem;letter-spacing:.06em}
  .shead h2{font-family:var(--mono);font-weight:700;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase}
  .stmt{font-family:var(--display);font-weight:400;font-size:clamp(1.5rem,3.9vw,3.1rem);line-height:1.08;letter-spacing:-.025em;max-width:24ch}
  .mani{display:grid;gap:1.1rem;max-width:62ch;margin-top:clamp(30px,4.5vh,52px);padding-top:clamp(22px,3vh,38px);border-top:1px solid var(--line)}
  .mani p{color:var(--ink-2);font-size:1.02rem;line-height:1.65}
  .how-lead{max-width:60ch;color:var(--ink-2);font-size:1.02rem;line-height:1.65;margin-bottom:clamp(30px,4.5vh,52px)}
  .roles{list-style:none}
  .role{display:grid;grid-template-columns:auto minmax(0,14rem) 1fr;gap:.3em 1.6rem;align-items:baseline;padding:1.15rem 0;border-top:1px solid var(--line)}
  .role:last-child{border-bottom:1px solid var(--line)}
  .r-n{font-family:var(--mono);font-size:.72rem;color:var(--accent-text);letter-spacing:.06em}
  .r-name{font-family:var(--display);font-weight:700;font-size:1.15rem;letter-spacing:-.02em;border-bottom:1px solid transparent;transition:border-color .2s,color .2s}
  .r-name:hover{color:var(--accent-text);border-color:var(--accent-text)}
  .r-desc{color:var(--muted);font-size:.96rem}
  @media (max-width:760px){ .role{grid-template-columns:auto 1fr} .r-desc{grid-column:2} }

  /* ═══════════ contact ═══════════ */
  .contact{background:var(--bg);padding-block:clamp(64px,10vh,140px);border-top:1px solid var(--line)}
  .contact-big{font-family:var(--display);font-weight:700;font-size:clamp(2.8rem,10vw,8rem);letter-spacing:-.045em;line-height:.9}
  .contact-sub{margin-top:1.1rem;max-width:46ch;color:var(--ink-2);font-size:1.02rem;line-height:1.6}
  .paths{display:grid;grid-template-columns:repeat(2,1fr);gap:.7rem;margin-top:clamp(36px,5vh,64px)}
  @media (max-width:680px){ .paths{grid-template-columns:1fr} }
  .path{display:grid;grid-template-columns:1fr auto;align-items:center;gap:.25em 1em;padding:clamp(20px,2.2vw,30px);
    border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--bg-2);
    transition:background .3s var(--ease-standard),color .3s var(--ease-standard),border-color .3s,box-shadow .3s}
  .path:hover,.path:focus-visible{background:var(--ink);color:var(--bg);border-color:var(--ink);box-shadow:var(--shadow-md)}
  .p-label{font-family:var(--display);font-weight:700;font-size:1.3rem;letter-spacing:-.02em}
  .p-desc{grid-column:1;font-family:var(--mono);font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);transition:color .3s}
  .path:hover .p-desc,.path:focus-visible .p-desc{color:var(--bg-3)}
  .p-go{grid-row:1 / span 2;grid-column:2;font-size:1.4rem;color:var(--accent-text);transition:transform .3s var(--ease-standard),color .3s}
  .path:hover .p-go,.path:focus-visible .p-go{transform:translate(4px,4px);color:var(--bg)}
  .crow{display:flex;flex-wrap:wrap;gap:1rem 2rem;margin-top:clamp(32px,5vh,56px);font-family:var(--mono);font-size:.8rem;color:var(--muted)}
  .crow a{border-bottom:1px solid var(--line);padding-bottom:.2em;transition:color .2s,border-color .2s}
  .crow a:hover{color:var(--accent-text);border-color:var(--accent-text)}

  .foot{display:flex;align-items:center;justify-content:space-between;gap:1rem 2rem;flex-wrap:wrap;
    padding-block:clamp(36px,5vh,64px);border-top:1px solid var(--line)}
  .foot .brand{font-size:1rem}
  .ftag{max-width:34ch;font-family:var(--mono);font-size:.74rem;line-height:1.5}
  .mono-s{font-family:var(--mono);font-size:.74rem}
  .muted{color:var(--muted)}

  @media (prefers-reduced-motion:reduce){
    .rootstage{height:auto!important}
    .rootstage-in{position:relative!important;min-height:0}
    .rootstage .wl,.rootstage .tagline,.rootstage .lead,.rootstage .cue,.rootstage .unit{opacity:1!important;transform:none!important}
    .roots .strand{stroke-dashoffset:0!important}
    .roots .origin,.roots .port{transform:scale(1)!important}
    .spine{transform:translateX(-50%) scaleY(1)!important}
    .unit .u-port{transform:translate(-50%,-50%) scale(1)!important}
    .cue i{animation:none}
  }
</style>

<script>
  let ran = false;
  const setup = () => {
    if (ran) return;
    if (!document.querySelector('[data-rootstage]')) return;
    ran = true;

    const reduce = matchMedia('(prefers-reduced-motion:reduce)').matches;
    const cleanups: Array<() => void> = [];
    const on = (t: EventTarget, ev: string, fn: any, o?: any) => {
      t.addEventListener(ev, fn, o); cleanups.push(() => t.removeEventListener(ev, fn, o));
    };

    const stage = document.querySelector<HTMLElement>('[data-rootstage]')!;
    const field = stage.querySelector<HTMLElement>('[data-field]')!;
    const svg = stage.querySelector<SVGSVGElement>('[data-roots]')!;
    const origin = svg.querySelector<SVGCircleElement>('[data-origin]')!;
    const strands = Array.from(svg.querySelectorAll<SVGPathElement>('[data-strand]'));
    const ports = Array.from(svg.querySelectorAll<SVGCircleElement>('[data-port]'));
    const cards = Array.from(stage.querySelectorAll<HTMLElement>('[data-unit]'));
    const backdrop = stage.querySelector<HTMLElement>('[data-backdrop]');
    const wide = matchMedia('(min-width:1024px)');
    stage.classList.add('js');

    // Strand geometry is measured off the real card positions, so the roots land
    // on the ports at any width.
    const draw = () => {
      if (!wide.matches) return;
      const fb = field.getBoundingClientRect();
      const w = Math.round(fb.width), h = Math.round(fb.height);
      if (w < 2 || h < 2) return;
      svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
      const ox = w / 2, oy = 2;
      origin.setAttribute('cx', String(ox)); origin.setAttribute('cy', String(oy));
      cards.forEach((card, i) => {
        const cb = card.getBoundingClientRect();
        const x = cb.left - fb.left + cb.width / 2, y = cb.top - fb.top, run = y - oy;
        strands[i].setAttribute('d', `M ${ox} ${oy} C ${ox} ${oy + run * 0.42}, ${x} ${y - run * 0.4}, ${x} ${y}`);
        ports[i].setAttribute('cx', String(x)); ports[i].setAttribute('cy', String(y));
      });
    };

    draw();
    // The hero plays on arrival — it is the first thing seen, not a reward for
    // scrolling. Capped at 600ms so a slow webfont never holds it back.
    if (reduce) stage.classList.add('go');
    else {
      const fonts = document.fonts ? document.fonts.ready : Promise.resolve();
      Promise.race([fonts, new Promise((r) => setTimeout(r, 600))])
        .then(() => { draw(); stage.classList.add('go'); });
    }

    let raf = 0;
    const schedule = () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(draw); };
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(schedule); ro.observe(field);
      cleanups.push(() => ro.disconnect());
    }
    on(window, 'resize', schedule, { passive: true });

    /* ── discovery: previewing a unit brings its world in behind the name ── */
    let previewTimer = 0;
    const preview = (id: string | null) => {
      clearTimeout(previewTimer);
      field.classList.toggle('gazing', id !== null);
      cards.forEach((c) => c.classList.toggle('gazed', c.dataset.id === id));
      strands.forEach((sd, j) => sd.classList.toggle('lit', cards[j]?.dataset.id === id));
      if (!backdrop) return;
      stage.classList.toggle('previewing', id !== null);
      backdrop.querySelectorAll<HTMLElement>('.bd').forEach((b) => b.classList.toggle('on', b.dataset.bd === id));
    };
    cards.forEach((card) => {
      const id = card.dataset.id!;
      card.addEventListener('mouseenter', () => preview(id));
      card.addEventListener('focus', () => preview(id));
      card.addEventListener('mouseleave', () => { previewTimer = window.setTimeout(() => preview(null), 90); });
      card.addEventListener('blur', () => { previewTimer = window.setTimeout(() => preview(null), 90); });
      // Entering a unit: hold the preview through the navigation so the plate the
      // card is showing is the plate the next page opens on.
      card.addEventListener('click', () => { clearTimeout(previewTimer); preview(id); });
    });

    /* ── the thread that still runs past the hero ── */
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-chapter]'));
    const applyThread = () => {
      for (const sec of sections) {
        const r = sec.getBoundingClientRect();
        const span = r.height + innerHeight * 0.5;
        const cp = span <= 0 ? 1 : (innerHeight * 0.85 - r.top) / span;
        sec.style.setProperty('--cp', Math.min(1, Math.max(0, cp)).toFixed(3));
      }
    };
    let t2 = false;
    const onScroll2 = () => {
      if (t2) return;
      t2 = true;
      requestAnimationFrame(() => { t2 = false; applyThread(); });
    };
    on(window, 'scroll', onScroll2, { passive: true });
    on(window, 'resize', onScroll2, { passive: true });
    applyThread();

    /* ── mobile nav ── */
    const hdr = document.querySelector<HTMLElement>('[data-nav]');
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
    const panel = document.querySelector<HTMLElement>('[data-menu]');
    if (btn && panel && hdr) {
      const setOpen = (open: boolean) => {
        btn.setAttribute('aria-expanded', String(open));
        panel.hidden = !open;
        hdr.classList.toggle('open', open);
        document.body.style.overflow = open ? 'hidden' : '';
      };
      btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
      panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
      on(document, 'keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { setOpen(false); btn.focus(); }
      });
      const mq = matchMedia('(min-width:901px)');
      const onMq = (e: MediaQueryListEvent) => { if (e.matches) setOpen(false); };
      mq.addEventListener('change', onMq);
      cleanups.push(() => mq.removeEventListener('change', onMq));
    }

    document.addEventListener('astro:before-swap', () => {
      ran = false;
      cleanups.forEach((fn) => fn());
    }, { once: true });
  };

  document.addEventListener('astro:page-load', setup);
  setup();
</script>
