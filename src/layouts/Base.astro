---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  theme?: 'theme-group' | 'theme-residencia' | 'theme-gr8' | 'theme-synergy' | 'theme-agency' | 'theme-prod' | 'theme-syn' | 'theme-res' | 'theme-res-ds' | 'theme-res-v3';
  /** Document language. Drives <html lang>, which screen readers use to pick a voice. */
  lang?: 'es' | 'en';
  /** Which share card to serve — a file in /public/og. */
  og?: 'home' | 'agency' | 'production' | 'gr8' | 'synergy' | 'work';
}
const { title, description = 'Residencia Group — a creative group of three studios.', theme = 'theme-group', lang = 'es', og = 'home' } = Astro.props;

/* ── canonical + language alternates ──
   Paths look like /residencia/v3/… (es) and /residencia/en/v3/… (en), so the
   counterpart is derived by adding or removing the single `en/` segment. */
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site ?? new URL('https://mrjaytee77.github.io');
const rest = Astro.url.pathname.replace(BASE, '').replace(/^\//, '');
const bare = rest.startsWith('en/') ? rest.slice(3) : rest;
const abs = (path: string) => new URL(`${BASE}/${path}`.replace(/\/{2,}/g, '/'), site).href;
const canonical = abs(rest);
const esHref = abs(bare);
const enHref = abs(`en/${bare}`);
const ogImage = abs(`og/${og}.jpg`);
const siteName = 'Residencia';

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Residencia',
  description,
  url: abs(''),
  logo: abs('ds/residencia-mark-noturno.png'),
  image: ogImage,
  email: 'cesar.j@residencia.com.mx',
  telephone: '+52 55 3228 8017',
  address: { '@type': 'PostalAddress', addressLocality: 'Ciudad de México', addressCountry: 'MX' },
  slogan: 'Creative Content Strategy',
  department: ['Residencia Agency', 'Residencia Producción', 'GR8 by Residencia', 'Synergy by Residencia']
    .map((n) => ({ '@type': 'Organization', name: n })),
};

const fonts =
  'https://fonts.googleapis.com/css2?' +
  'family=Archivo:wght@400;500;600;700;800&' +
  'family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&' +
  'family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&' +
  'family=Hanken+Grotesk:wght@400;500;600;700&' +
  'family=Instrument+Serif:ital@0;1&' +
  'family=Plus+Jakarta+Sans:wght@400;500;600;700;800&' +
  'family=Space+Mono:wght@400;700&display=swap';
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#15140F" />
  <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={fonts} rel="stylesheet" />

  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="es" href={esHref} />
  <link rel="alternate" hreflang="en" href={enHref} />
  <link rel="alternate" hreflang="x-default" href={esHref} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
  <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_MX'} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <meta name="robots" content="index,follow" />
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />

  <ViewTransitions />
</head>
<body class={theme}>
  <div class="cursor" id="cursor" aria-hidden="true"></div>
  <slot />

  <script>
    // View transitions swap the DOM without re-running module scripts, so every
    // per-page binding is rebuilt on astro:page-load (which also fires on the
    // first load). Window-level listeners are bound once and re-query the DOM.
    let cursorEl: HTMLElement | null = null;
    let loopRunning = false;
    let tx = innerWidth / 2, ty = innerHeight / 2, cx = tx, cy = ty;

    const startCursor = () => {
      if (loopRunning) return;
      loopRunning = true;
      addEventListener('mousemove', (e) => { tx = e.clientX; ty = e.clientY; }, { passive: true });
      const loop = () => {
        cx += (tx - cx) * 0.18; cy += (ty - cy) * 0.18;
        if (cursorEl) cursorEl.style.transform = `translate(${cx}px,${cy}px) translate(-50%,-50%)`;
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
    };

    let lastY = 0;
    const onNavScroll = () => {
      const header = document.querySelector('[data-nav]');
      if (!header) return;
      const y = scrollY;
      header.classList.toggle('scrolled', y > 40);
      if (y > lastY && y > 420) header.classList.add('hide'); else header.classList.remove('hide');
      lastY = y;
    };
    addEventListener('scroll', onNavScroll, { passive: true });

    let io: IntersectionObserver | null = null;

    const initBase = () => {
      cursorEl = document.getElementById('cursor');
      if (cursorEl && matchMedia('(hover:hover)').matches) {
        startCursor();
        document.querySelectorAll('a, button, [data-hot]').forEach((el) => {
          el.addEventListener('mouseenter', () => cursorEl?.classList.add('hot'));
          el.addEventListener('mouseleave', () => cursorEl?.classList.remove('hot'));
        });
      }

      io?.disconnect();
      io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io?.unobserve(e.target); } });
      }, { threshold: 0.16 });
      document.querySelectorAll('.reveal').forEach((el) => io!.observe(el));

      lastY = 0;
      onNavScroll();
    };

    document.addEventListener('astro:page-load', initBase);
  </script>
</body>
</html>
